{%- comment -%}
  Compare-at for a cart line / variant.
  Params: price, compare_at_price, product_handle (optional)
  Skin Tint & Liquid Blush never show a cut/compare price.
{%- endcomment -%}
{%- if product_handle != blank and product_handle contains 'skin-tint' -%}
0
{%- elsif product_handle != blank and product_handle contains 'liquid-blush' -%}
0
{%- elsif compare_at_price != blank and compare_at_price > price -%}
{{- compare_at_price -}}
{%- elsif price > 0 -%}
{{- price | times: 2 -}}
{%- else -%}
0
{%- endif -%}
