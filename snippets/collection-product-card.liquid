{%- comment -%}
  Shared collection product card — matches homepage Wellness Collection cards.
  Accepts: product
{%- endcomment -%}

{%- assign product_tags = product.tags | join: ',' | downcase -%}
{%- assign cat = 'general' -%}
{%- if product_tags contains 'healthcare' or product_tags contains 'health' -%}
  {%- assign cat = cat | append: ' healthcare' -%}
{%- endif -%}
{%- if product_tags contains 'organic' or product_tags contains 'natural' -%}
  {%- assign cat = cat | append: ' organic' -%}
{%- endif -%}
{%- if product_tags contains 'bundle' or product_tags contains 'pack' -%}
  {%- assign cat = cat | append: ' bundle' -%}
{%- endif -%}
{%- if product.handle contains 'skin-tint' or product.handle contains 'liquid-blush' or product_tags contains 'makeup' or product_tags contains 'blush' -%}
  {%- assign cat = cat | append: ' makeup' -%}
{%- endif -%}

{%- assign show_bestseller = false -%}
{%- if product.handle == 'skinny-sips-weight-loss-kehwa'
  or product.handle == 'royce-hair-oil-sunnah-blessed'
  or product.handle == 'skin-tint'
  or product.handle == 'liquid-blush' -%}
  {%- assign show_bestseller = true -%}
{%- endif -%}

{%- capture compare_cents -%}{% render 'sale-compare-at', product: product %}{%- endcapture -%}
{%- assign compare_price = compare_cents | plus: 0 -%}

<div
  class="product-card collection-group"
  data-category="{{ cat }}"
>
  <div class="product-img-wrap">
    {% if show_bestseller %}
      <span class="best-seller-badge">BESTSELLER</span>
    {% endif %}
    <span class="sale-badge">50% OFF</span>
    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          class="product-img"
          alt="{{ product.title | escape }}"
          loading="lazy"
          width="600"
          height="600"
        >
      {% endif %}
    </a>
  </div>

  <div class="product-info">
    <h3 class="product-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>

    {% render 'product-card-stars', product: product, style: 'catalog' %}

    <div class="product-price-wrapper">
      {% if compare_price > product.price %}
        <span class="product-price-old">{{ compare_price | money }}</span>
      {% endif %}
      <span class="product-price">{{ product.price | money }}</span>
    </div>

    <form method="post" action="/cart/add" class="laushe-collection-atc">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      {% if settings.force_all_sold_out %}
        <button type="button" class="btn-add" disabled aria-disabled="true">
          <span class="atc-text">{{ settings.sold_out_button_label | default: 'Sold Out' }}</span>
        </button>
      {% else %}
        <button type="submit" class="btn-add">
          <span class="atc-text">SHOP NOW</span>
          <span class="atc-loading" style="display: none;">Adding...</span>
        </button>
      {% endif %}
    </form>
  </div>
</div>
