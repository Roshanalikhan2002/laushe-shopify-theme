{% comment %}
  Professional line icons for Laushe (no emoji style).
  Usage: {% render 'icon-laushe', name: 'beaker' %}
{% endcomment %}
{% case name %}
  {% when 'leaf' %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M24 42V22" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M24 40c-8.5-1.5-14-7.5-14-16 0-11 10.5-18 20-20 1.5 10 0 20-6 28" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M24 40c8.5-1.5 14-7.5 14-16 0-6-3-11.5-8-15.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M18 20c3 2.5 6 4 10 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>

  {% when 'flash' %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M26 6L12 26h10l-2 16 16-22H26l0-14z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
    </svg>

  {% when 'shield' %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M24 6l14 5v11c0 9.5-6.2 16.8-14 20-7.8-3.2-14-10.5-14-20V11l14-5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M17 24l5 5 9-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {% when 'bulb' %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M24 6a12 12 0 0 0-7 21c1.2 1.2 2 2.6 2.3 4.2h9.4c.3-1.6 1.1-3 2.3-4.2A12 12 0 0 0 24 6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M20 36h8M21 40h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>

  {% when 'beaker' %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M17 8h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M20 8v9.5L12.8 36.2A4 4 0 0 0 16.5 42h15a4 4 0 0 0 3.7-5.8L28 17.5V8" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M15 30h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <circle cx="21" cy="34" r="1.4" fill="currentColor"/>
      <circle cx="27" cy="35.5" r="1.1" fill="currentColor"/>
    </svg>

  {% when 'skull' %}
    {% comment %} Professional "no heavy metals" mark — ban over droplet, not emoji skull {% endcomment %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="24" cy="24" r="16" stroke="currentColor" stroke-width="2"/>
      <path d="M24 14c-4.5 0-8 3.8-8 9 0 5.5 5.2 10.5 8 13 2.8-2.5 8-7.5 8-13 0-5.2-3.5-9-8-9z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M13 35L35 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>

  {% when 'globe' %}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="2"/>
      <path d="M9 24h30" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M24 9c4.5 4 7 9.2 7 15s-2.5 11-7 15c-4.5-4-7-9.2-7-15s2.5-11 7-15z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M14 16.5h20M14 31.5h20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
{% endcase %}
