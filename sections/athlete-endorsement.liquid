{% schema %}
{
  "name": "Athlete endorsement",
  "settings": [
    { "id": "image", "type": "image_picker", "label": "Athlete Image" },
    { "id": "quote", "type": "text", "label": "Large Quote", "default": "I love that it makes better health accessible to everyone" },
    { "id": "description", "type": "textarea", "label": "Full Testimonial", "default": "As a professional athlete, I've always looked for ways to stay sharp, feel my best, and fuel my body without overcomplicating it. Laushe uses clean, Sunnah-blessed ingredients that actually deliver. It's about performing at the highest level while staying rooted in tradition." },
    { "id": "name", "type": "text", "label": "Athlete Name", "default": "Arshad Nadeem" },
    { "id": "title", "type": "text", "label": "Athlete Title", "default": "OLYMPIC GOLD MEDALIST, JAVELIN THROW CHAMPION" },
    { "id": "btn_txt", "type": "text", "label": "Button Text", "default": "Shop Laushe Now" },
    { "id": "btn_link", "type": "url", "label": "Button Link" },
    { "id": "disclaimer", "type": "textarea", "label": "Disclaimer Text", "default": "Arshad Nadeem is a proud ambassador and user of Laushe. He trusts our natural formulations for his recovery and peak performance." }
  ],
  "presets": [{ "name": "Athlete endorsement", "category": "Laushe Sections" }]
}
{% endschema %}

<section id="athlete-{{ section.id }}" class="athlete-laushe-section section-padding" style="background:#ffffff; color:#333333;">
  <div class="container">
    <div class="athlete-luxe-grid">
      <div class="athlete-luxe-img">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" class="luxe-img-fit" alt="{{ section.settings.name | escape }}">
        {% else %}
          <div class="luxe-img-fit athlete-photo-fallback" style="aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;background:#E8F3ED;color:#007E40;font-weight:700;border-radius:40px;">
            Add athlete photo
          </div>
        {% endif %}
      </div>

      <div class="athlete-luxe-content" style="color:#333333;">
        <div class="quote-mark-wrap" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="#dcb360" opacity="0.18" style="width:80px;height:80px;">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-10zm-14 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
        </div>

        <h2 class="athlete-luxe-quote" style="color:#dcb360 !important; -webkit-text-fill-color:#dcb360;">"{{ section.settings.quote }}"</h2>
        <p class="athlete-luxe-body" style="color:#333333 !important; -webkit-text-fill-color:#333333;">{{ section.settings.description }}</p>

        <div class="athlete-luxe-meta">
          <h4 class="meta-name" style="color:#007E40 !important; -webkit-text-fill-color:#007E40;">{{ section.settings.name }}</h4>
          <p class="meta-title" style="color:#dcb360 !important; -webkit-text-fill-color:#dcb360;">{{ section.settings.title }}</p>
        </div>

        <div class="athlete-luxe-cta">
          <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="btn-pill btn-forest" style="background:#dcb360 !important; color:#007E40 !important; -webkit-text-fill-color:#007E40;">
            {{ section.settings.btn_txt }} &nbsp; <span>→</span>
          </a>
        </div>

        <p class="athlete-luxe-disclaimer" style="color:#555555 !important; -webkit-text-fill-color:#555555;">{{ section.settings.disclaimer }}</p>
      </div>
    </div>
  </div>
</section>

<style>
  #athlete-{{ section.id }} {
    background: #ffffff !important;
    color: #333333 !important;
  }

  #athlete-{{ section.id }} .athlete-luxe-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  #athlete-{{ section.id }} .luxe-img-fit {
    width: 100%;
    height: auto;
    border-radius: 40px;
    display: block;
    box-shadow: 0 40px 100px rgba(0,0,0,0.1);
  }

  #athlete-{{ section.id }} .athlete-luxe-content {
    position: relative;
    padding-top: 20px;
  }

  #athlete-{{ section.id }} .quote-mark-wrap {
    position: absolute;
    top: -40px;
    left: -20px;
    z-index: 0;
    pointer-events: none;
  }

  #athlete-{{ section.id }} .athlete-luxe-quote {
    position: relative;
    z-index: 1;
    font-family: 'Poppins', sans-serif !important;
    font-size: clamp(28px, 4vw, 48px) !important;
    line-height: 1.15 !important;
    font-weight: 800 !important;
    margin: 0 0 28px !important;
    color: #dcb360 !important;
    -webkit-text-fill-color: #dcb360 !important;
  }

  #athlete-{{ section.id }} .athlete-luxe-body {
    position: relative;
    z-index: 1;
    font-family: 'Inter', 'Poppins', sans-serif !important;
    font-size: 17px !important;
    line-height: 1.7 !important;
    margin: 0 0 36px !important;
    color: #333333 !important;
    -webkit-text-fill-color: #333333 !important;
  }

  #athlete-{{ section.id }} .athlete-luxe-meta {
    margin-bottom: 40px;
  }

  #athlete-{{ section.id }} .meta-name {
    font-family: 'Poppins', sans-serif !important;
    font-size: 22px !important;
    font-weight: 800 !important;
    margin: 0 0 5px !important;
    color: #007E40 !important;
    -webkit-text-fill-color: #007E40 !important;
  }

  #athlete-{{ section.id }} .meta-title {
    font-size: 13px !important;
    font-weight: 700 !important;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 !important;
    color: #dcb360 !important;
    -webkit-text-fill-color: #dcb360 !important;
  }

  #athlete-{{ section.id }} .athlete-luxe-cta {
    margin-bottom: 30px;
  }

  #athlete-{{ section.id }} .btn-forest {
    background: #dcb360 !important;
    color: #007E40 !important;
    -webkit-text-fill-color: #007E40 !important;
  }

  #athlete-{{ section.id }} .athlete-luxe-disclaimer {
    font-size: 12px !important;
    line-height: 1.6 !important;
    font-style: italic;
    max-width: 500px;
    color: #555555 !important;
    -webkit-text-fill-color: #555555 !important;
  }

  @media (max-width: 1024px) {
    #athlete-{{ section.id }} .athlete-luxe-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    #athlete-{{ section.id }} .athlete-luxe-img {
      max-width: 600px;
      margin: 0 auto;
    }
    #athlete-{{ section.id }} .athlete-luxe-quote {
      font-size: 32px !important;
    }
    #athlete-{{ section.id }} .quote-mark-wrap {
      top: -20px;
      left: 0;
    }
  }
</style>
