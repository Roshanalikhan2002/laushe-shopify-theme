<!--
  Section: Final CTA Banner
  Brand: #007E40 green, #dcb360 gold, Poppins + Inter
-->

{% schema %}
{
  "name": "Final CTA Banner",
  "settings": [
    {
      "id": "headline",
      "type": "text",
      "label": "Headline",
      "default": "Ready to Transform Your Health?"
    },
    {
      "id": "subtext",
      "type": "textarea",
      "label": "Subtext",
      "default": "Join over 50,000+ satisfied customers today and experience the Laushe difference."
    },
    {
      "id": "cta_text",
      "type": "text",
      "label": "CTA Text",
      "default": "SHOP NOW"
    },
    {
      "id": "cta_url",
      "type": "url",
      "label": "CTA Link"
    },
    {
       "id": "bg_color",
       "type": "color",
       "label": "Background Color",
       "default": "#007E40"
    }
  ],
  "presets": [
     {
       "name": "Final CTA Banner",
       "category": "Custom"
     }
  ]
}
{% endschema %}

<section class="final-cta-section section-padding" style="background-color: {{ section.settings.bg_color | default: '#007E40' }};">
  <div class="container-wide">
    <div class="final-cta-wrapper text-center animate-fade-up">
       <h2 class="final-cta-headline h1">{{ section.settings.headline }}</h2>
       <p class="final-cta-subtext">{{ section.settings.subtext }}</p>

       <div class="final-cta-actions">
          <a href="{{ section.settings.cta_url | default: '#product-form' }}" class="button-primary final-btn">{{ section.settings.cta_text }}</a>
          <p class="final-trust-badge">⭐ 4.9/5 Star Rating</p>
       </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    overflow: hidden;
    color: #fff;
    background-color: #007E40;
  }

  .final-cta-headline {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    color: #fff !important;
    margin: 0 auto 20px;
    max-width: 800px;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .final-cta-subtext {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.92) !important;
    margin: 0 auto 36px;
    max-width: 600px;
    line-height: 1.55;
  }

  .final-btn {
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    font-weight: 800;
    padding: 18px 48px;
    background: #dcb360;
    color: #007E40 !important;
    border: none;
    border-radius: 50px;
    text-decoration: none;
    display: inline-block;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: none;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
    cursor: pointer;
  }

  .final-btn:hover {
    background: #e8c878;
    transform: translateY(-2px);
    color: #007E40 !important;
  }

  .final-btn:active {
    transform: translateY(0);
  }

  .final-trust-badge {
    font-family: 'Inter', sans-serif;
    margin-top: 22px;
    color: #fff !important;
    opacity: 0.9;
    font-size: 0.9rem;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .final-cta-headline {
      font-size: 2rem;
    }

    .final-cta-subtext {
      font-size: 1rem;
    }

    .final-btn {
      padding: 16px 36px;
      font-size: 0.95rem;
    }
  }
</style>
