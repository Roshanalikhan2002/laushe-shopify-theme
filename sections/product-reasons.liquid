{% comment %}
  Blume-style reasons carousel for product pages (Laushe colors/fonts)
{% endcomment %}

<section
  id="reasons-{{ section.id }}"
  class="product-reasons"
  style="--pr-bg: {{ section.settings.bg_color }}; --pr-heading: {{ section.settings.heading_color }}; --pr-accent: {{ section.settings.accent_color }};"
>
  <div class="product-reasons__inner">
    <div class="product-reasons__header">
      <h2 class="product-reasons__title">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="product-reasons__sub">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="product-reasons__carousel-wrap">
      <button type="button" class="product-reasons__nav product-reasons__nav--prev" data-pr-prev aria-label="Previous">
        <span aria-hidden="true">&#8592;</span>
      </button>

      <div class="product-reasons__track" data-pr-track>
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <article class="product-reasons__card" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <div class="product-reasons__icon" aria-hidden="true">{{ block.settings.icon }}</div>
              {% endif %}
              <h3 class="product-reasons__card-title">{{ block.settings.title }}</h3>
              <p class="product-reasons__card-text">{{ block.settings.text }}</p>
            </article>
          {% endfor %}
        {% else %}
          <article class="product-reasons__card">
            <div class="product-reasons__icon" aria-hidden="true">🌿</div>
            <h3 class="product-reasons__card-title">100% Pure & Natural</h3>
            <p class="product-reasons__card-text">No fillers, no artificial additives — just clean, Sunnah-blessed ingredients your body recognizes.</p>
          </article>
          <article class="product-reasons__card">
            <div class="product-reasons__icon" aria-hidden="true">⚡</div>
            <h3 class="product-reasons__card-title">Daily Energy Without Crash</h3>
            <p class="product-reasons__card-text">Support steady vitality through the day — without stimulants or the afternoon slump.</p>
          </article>
          <article class="product-reasons__card">
            <div class="product-reasons__icon" aria-hidden="true">💚</div>
            <h3 class="product-reasons__card-title">Gut-Friendly Nutrition</h3>
            <p class="product-reasons__card-text">Formulated to support digestion and nutrient absorption as part of your daily ritual.</p>
          </article>
        {% endif %}
      </div>

      <button type="button" class="product-reasons__nav product-reasons__nav--next" data-pr-next aria-label="Next">
        <span aria-hidden="true">&#8594;</span>
      </button>
    </div>
  </div>
</section>

<style>
  #reasons-{{ section.id }} {
    background: var(--pr-bg, #E8F3ED);
    padding: clamp(48px, 8vw, 90px) 0;
    overflow: hidden;
  }

  #reasons-{{ section.id }} .product-reasons__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #reasons-{{ section.id }} .product-reasons__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px;
  }

  #reasons-{{ section.id }} .product-reasons__title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--pr-heading, #dcb360);
    margin: 0 0 14px;
  }

  #reasons-{{ section.id }} .product-reasons__sub {
    font-family: 'Inter', 'Poppins', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #444;
    margin: 0;
  }

  #reasons-{{ section.id }} .product-reasons__carousel-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #reasons-{{ section.id }} .product-reasons__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 8px 4px 16px;
    flex: 1;
    min-width: 0;
  }

  #reasons-{{ section.id }} .product-reasons__track::-webkit-scrollbar {
    display: none;
  }

  #reasons-{{ section.id }} .product-reasons__card {
    flex: 0 0 calc((100% - 40px) / 3);
    min-width: 260px;
    scroll-snap-align: start;
    background: #ffffff;
    border-radius: 20px;
    padding: 28px 24px 32px;
    box-shadow: 0 10px 30px rgba(0, 66, 37, 0.06);
    border: 1px solid rgba(0, 126, 64, 0.08);
  }

  #reasons-{{ section.id }} .product-reasons__icon {
    font-size: 28px;
    line-height: 1;
    margin-bottom: 16px;
  }

  #reasons-{{ section.id }} .product-reasons__card-title {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: var(--pr-accent, #007E40);
    margin: 0 0 12px;
    line-height: 1.3;
  }

  #reasons-{{ section.id }} .product-reasons__card-text {
    font-family: 'Inter', 'Poppins', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #444;
    margin: 0;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(0, 66, 37, 0.12);
  }

  #reasons-{{ section.id }} .product-reasons__nav {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid rgba(0, 126, 64, 0.25);
    background: #ffffff;
    color: #007E40;
    font-size: 18px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  #reasons-{{ section.id }} .product-reasons__nav:hover {
    background: #007E40;
    color: #fff;
    border-color: #007E40;
  }

  @media (max-width: 900px) {
    #reasons-{{ section.id }} .product-reasons__card {
      flex: 0 0 78%;
      min-width: 240px;
    }
    #reasons-{{ section.id }} .product-reasons__nav {
      display: none;
    }
    #reasons-{{ section.id }} .product-reasons__header {
      margin-bottom: 28px;
      padding: 0 4px;
    }
    #reasons-{{ section.id }} .product-reasons__sub {
      font-size: 15px;
    }
  }

  @media (max-width: 600px) {
    #reasons-{{ section.id }} {
      padding: 40px 0;
    }
    #reasons-{{ section.id }} .product-reasons__card {
      flex: 0 0 85%;
      padding: 22px 18px 26px;
    }
    #reasons-{{ section.id }} .product-reasons__card-title {
      font-size: 16px;
    }
    #reasons-{{ section.id }} .product-reasons__card-text {
      font-size: 14px;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('reasons-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-pr-track]');
    var prev = root.querySelector('[data-pr-prev]');
    var next = root.querySelector('[data-pr-next]');
    if (!track) return;

    function scrollByCard(dir) {
      var card = track.querySelector('.product-reasons__card');
      var amount = card ? card.getBoundingClientRect().width + 20 : 300;
      track.scrollBy({ left: dir * amount, behavior: 'smooth' });
    }

    if (prev) prev.addEventListener('click', function () { scrollByCard(-1); });
    if (next) next.addEventListener('click', function () { scrollByCard(1); });
  })();
</script>

{% schema %}
{
  "name": "Product Reasons Carousel",
  "tag": "section",
  "class": "section-product-reasons",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Six Reasons to Choose Laushe"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pure, Sunnah-blessed wellness made for everyday life. Here’s why thousands trust Laushe as their daily ritual."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#E8F3ED"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#dcb360"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Card title color",
      "default": "#007E40"
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or short text)",
          "default": "🌿"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Pure & Natural"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "No fillers, no artificial additives — just clean ingredients your body recognizes."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Reasons Carousel",
      "category": "Laushe Sections",
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "icon": "🌿",
            "title": "100% Pure & Natural",
            "text": "No fillers, no artificial additives — just clean, Sunnah-blessed ingredients your body recognizes."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "⚡",
            "title": "Steady Daily Energy",
            "text": "Support calm, lasting vitality through the day — without stimulants or the afternoon crash."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "💚",
            "title": "Gut-Friendly Nutrition",
            "text": "Crafted to support digestion and nutrient absorption as part of your everyday wellness ritual."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "✨",
            "title": "Visible, Feelable Results",
            "text": "Thousands of customers report better energy, digestion, and overall balance with consistent use."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "🛡️",
            "title": "Tested for Purity",
            "text": "Quality you can trust — thoughtfully sourced and made to Laushe’s purity standards."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "🌙",
            "title": "Sunnah-Blessed Ritual",
            "text": "Rooted in tradition and made for modern life — a simple daily habit that fits your routine."
          }
        }
      ]
    }
  ]
}
{% endschema %}
