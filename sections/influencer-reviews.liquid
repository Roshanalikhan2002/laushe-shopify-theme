{% comment %} Influencer / UGC reviews carousel — Blume-style, images optional {% endcomment %}
<section
  class="inf-reviews"
  id="inf-reviews-{{ section.id }}"
  style="--inf-bg: {{ section.settings.bg_color }}; --inf-heading: {{ section.settings.heading_color }};"
>
  <div class="inf-reviews__inner">
    <div class="inf-reviews__header">
      <div class="inf-reviews__stars" aria-hidden="true">★★★★★</div>
      <h2 class="inf-reviews__title">{{ section.settings.heading }}</h2>
    </div>

    <div class="inf-reviews__carousel-wrap">
      <button type="button" class="inf-reviews__nav inf-reviews__nav--prev" data-inf-prev aria-label="Previous">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="inf-reviews__track" data-inf-track>
        {% for block in section.blocks %}
          <article class="inf-reviews__card" {{ block.shopify_attributes }}>
            <a
              class="inf-reviews__media"
              href="{{ block.settings.link | default: '#' }}"
              {% if block.settings.link == blank %}onclick="return false;"{% endif %}
              target="{% if block.settings.link != blank %}_blank{% else %}_self{% endif %}"
              rel="noopener"
            >
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.handle | default: 'Influencer review' | escape }}"
                  loading="lazy"
                  width="400"
                  height="520"
                >
              {% else %}
                <div class="inf-reviews__placeholder" aria-hidden="true"></div>
              {% endif %}
            </a>
            {% if block.settings.handle != blank %}
              <p class="inf-reviews__handle">{{ block.settings.handle }}</p>
            {% endif %}
          </article>
        {% else %}
          {% for i in (1..6) %}
            <article class="inf-reviews__card">
              <div class="inf-reviews__media">
                <div class="inf-reviews__placeholder" aria-hidden="true"></div>
              </div>
              <p class="inf-reviews__handle">@laushebyzahra</p>
            </article>
          {% endfor %}
        {% endfor %}
      </div>

      <button type="button" class="inf-reviews__nav inf-reviews__nav--next" data-inf-next aria-label="Next">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  #inf-reviews-{{ section.id }} {
    background: var(--inf-bg, #007e40);
    padding: clamp(48px, 8vw, 88px) 0;
    overflow: hidden;
  }
  #inf-reviews-{{ section.id }} .inf-reviews__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
  }
  #inf-reviews-{{ section.id }} .inf-reviews__header {
    text-align: center;
    margin-bottom: clamp(28px, 5vw, 44px);
  }
  #inf-reviews-{{ section.id }} .inf-reviews__stars {
    color: #c9a227;
    font-size: 18px;
    letter-spacing: 4px;
    margin-bottom: 12px;
  }
  #inf-reviews-{{ section.id }} .inf-reviews__title {
    margin: 0;
    font-family: 'Nunito', Georgia, serif;
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 700;
    color: var(--inf-heading, #007e40);
    letter-spacing: -0.02em;
  }

  #inf-reviews-{{ section.id }} .inf-reviews__carousel-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  #inf-reviews-{{ section.id }} .inf-reviews__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 4px 4px 12px;
    width: 100%;
  }
  #inf-reviews-{{ section.id }} .inf-reviews__track::-webkit-scrollbar { display: none; }

  #inf-reviews-{{ section.id }} .inf-reviews__card {
    flex: 0 0 calc((100% - 54px) / 4);
    scroll-snap-align: start;
    min-width: 0;
  }
  #inf-reviews-{{ section.id }} .inf-reviews__media {
    display: block;
    border-radius: 22px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #e8e2d6;
    text-decoration: none;
  }
  #inf-reviews-{{ section.id }} .inf-reviews__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #inf-reviews-{{ section.id }} .inf-reviews__placeholder {
    width: 100%;
    height: 100%;
    background:
      linear-gradient(145deg, rgba(255,255,255,0.35), transparent 45%),
      #ddd5c6;
  }
  #inf-reviews-{{ section.id }} .inf-reviews__handle {
    margin: 10px 0 0;
    font-size: 13px;
    color: #6b6b6b;
    font-family: 'Nunito', sans-serif;
    font-weight: 500;
  }

  #inf-reviews-{{ section.id }} .inf-reviews__nav {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: #d8ebe0;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    z-index: 2;
  }
  #inf-reviews-{{ section.id }} .inf-reviews__nav:hover {
    background: #c5e0d2;
    transform: scale(1.04);
  }

  @media (max-width: 990px) {
    #inf-reviews-{{ section.id }} .inf-reviews__card {
      flex-basis: calc((100% - 18px) / 2);
    }
  }
  @media (max-width: 749px) {
    #inf-reviews-{{ section.id }} .inf-reviews__carousel-wrap { gap: 0; }
    #inf-reviews-{{ section.id }} .inf-reviews__nav {
      position: absolute;
      top: 42%;
      transform: translateY(-50%);
      box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    }
    #inf-reviews-{{ section.id }} .inf-reviews__nav--prev { left: 0; }
    #inf-reviews-{{ section.id }} .inf-reviews__nav--next { right: 0; }
    #inf-reviews-{{ section.id }} .inf-reviews__track {
      padding-inline: 8px;
      gap: 14px;
    }
    #inf-reviews-{{ section.id }} .inf-reviews__card {
      flex-basis: 78%;
    }
    #inf-reviews-{{ section.id }} .inf-reviews__media {
      border-radius: 18px;
    }
  }
</style>

<script>
  (function() {
    const root = document.getElementById('inf-reviews-{{ section.id }}');
    if (!root) return;
    const track = root.querySelector('[data-inf-track]');
    const prev = root.querySelector('[data-inf-prev]');
    const next = root.querySelector('[data-inf-next]');
    if (!track || !prev || !next) return;

    function scrollByCard(dir) {
      const card = track.querySelector('.inf-reviews__card');
      if (!card) return;
      const step = card.getBoundingClientRect().width + 18;
      track.scrollBy({ left: dir * step, behavior: 'smooth' });
    }

    prev.addEventListener('click', () => scrollByCard(-1));
    next.addEventListener('click', () => scrollByCard(1));
  })();
</script>

{% schema %}
{
  "name": "Influencer Reviews",
  "tag": "section",
  "class": "section-influencer-reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Laushe with Us"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F7F3EA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#007e40"
    }
  ],
  "blocks": [
    {
      "type": "influencer",
      "name": "Influencer card",
      "settings": [
        {
          "type": "text",
          "id": "handle",
          "label": "Handle",
          "default": "@laushebyzahra"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (leave empty for placeholder)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Social / post link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Influencer Reviews",
      "category": "Laushe Sections",
      "blocks": [
        { "type": "influencer", "settings": { "handle": "@laushebyzahra" } },
        { "type": "influencer", "settings": { "handle": "@zahra.wellness" } },
        { "type": "influencer", "settings": { "handle": "@natural.glow" } },
        { "type": "influencer", "settings": { "handle": "@pure.rituals" } },
        { "type": "influencer", "settings": { "handle": "@sunnah.care" } },
        { "type": "influencer", "settings": { "handle": "@daily.elixir" } }
      ]
    }
  ]
}
{% endschema %}
