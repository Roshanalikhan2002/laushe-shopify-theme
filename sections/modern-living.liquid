{% schema %}
{
  "name": "Modern Living Problem",
  "settings": [
    { "id": "heading", "type": "text", "label": "Heading", "default": "Modern Living Leaves Our Bodies Deficient" },
    { "id": "description", "type": "textarea", "label": "Description", "default": "Laushe is the natural solution that fills the gaps in modern nutrition." },
    { "id": "stat_1_num", "type": "text", "label": "Stat 1 Number", "default": "90%" },
    { "id": "stat_1_txt", "type": "text", "label": "Stat 1 Text", "default": "of adults lack daily essential nutrients." },
    { "id": "stat_2_num", "type": "text", "label": "Stat 2 Number", "default": "61%" },
    { "id": "stat_2_txt", "type": "text", "label": "Stat 2 Text", "default": "experience regular digestive issues." },
    { "id": "btn_txt", "type": "text", "label": "Button Text", "default": "Start Your Journey" },
    { "id": "btn_link", "type": "url", "label": "Button Link" },
    { "id": "side_image", "type": "image_picker", "label": "Side Image" }
  ],
  "presets": [{ "name": "Modern Living Problem", "category": "Laushe Sections" }]
}
{% endschema %}

<section class="modern-living-section section-padding">
  <div class="container">
    <div class="modern-grid">
      <!-- CONTENT -->
      <div class="modern-content">
        <h2 class="modern-heading">{{ section.settings.heading }}</h2>
        <p class="modern-desc">{{ section.settings.description }}</p>
        
        <div class="stats-row-v2">
          <div class="stat-item-v2">
            <span class="stat-num-v2 js-count-up" data-count="{{ section.settings.stat_1_num | escape }}">{{ section.settings.stat_1_num }}</span>
            <span class="stat-txt-v2">{{ section.settings.stat_1_txt }}</span>
          </div>
          <div class="stat-item-v2">
            <span class="stat-num-v2 js-count-up" data-count="{{ section.settings.stat_2_num | escape }}">{{ section.settings.stat_2_num }}</span>
            <span class="stat-txt-v2">{{ section.settings.stat_2_txt }}</span>
          </div>
        </div>

        <div class="cta-wrap" style="margin-top: 40px;">
          <a href="{{ section.settings.btn_link | default: '#' }}" class="btn-pill btn-forest" style="text-decoration: none;">
            {{ section.settings.btn_txt }}
          </a>
        </div>
      </div>

      <!-- IMAGE -->
      <div class="modern-image-wrap">
        {% if section.settings.side_image %}
          <img src="{{ section.settings.side_image | img_url: '1000x' }}" class="modern-img" alt="Health Deficiency">
        {% else %}
          <img src="{{ 'modern-living-deficient.jpg' | asset_url }}" class="modern-img" alt="Health Deficiency">
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .modern-living-section {
    background: #ffffff;
    color: #333333;
  }

  .modern-living-section .modern-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 80px;
    align-items: center;
  }
  
  .modern-living-section .modern-heading {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.1;
    margin-bottom: 25px;
    color: #dcb360 !important; /* brand yellow/gold */
    font-weight: 800;
  }
  
  .modern-living-section .modern-desc {
    font-family: 'Inter', 'Poppins', sans-serif;
    font-size: 18px;
    color: #333333 !important;
    margin-bottom: 50px;
    max-width: 500px;
    line-height: 1.6;
  }
  
  .modern-living-section .stats-row-v2 {
    display: flex;
    gap: 40px;
  }
  
  .modern-living-section .stat-item-v2 {
    display: flex;
    flex-direction: column;
    gap: 15px;
    max-width: 180px;
  }
  
  .modern-living-section .stat-num-v2 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 800;
    color: #007E40 !important; /* Quality section green */
    line-height: 1;
  }
  
  .modern-living-section .stat-txt-v2 {
    font-family: 'Inter', 'Poppins', sans-serif;
    font-size: 14px;
    color: #444444 !important;
    line-height: 1.5;
    font-weight: 500;
  }

  .modern-living-section .btn-forest {
    background: #007E40 !important;
    color: #ffffff !important;
  }
  .modern-living-section .btn-forest:hover {
    background: #006534 !important;
    color: #ffffff !important;
  }
  
  .modern-living-section .modern-img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: 40px;
    display: block;
    box-shadow: 0 30px 60px rgba(0,0,0,0.1);
  }

  .modern-living-section .placeholder-bg {
    background: #E8F3ED !important;
    border: 1px dashed rgba(0, 126, 64, 0.25);
  }
  
  @media (max-width: 1024px) {
    .modern-living-section .modern-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 40px;
    }
    .modern-living-section .modern-content { order: 2; }
    .modern-living-section .modern-image-wrap { order: 1; max-width: 500px; width: 100%; margin: 0 auto; }
    .modern-living-section .modern-desc { margin: 0 auto 40px; }
    .modern-living-section .stats-row-v2 {
      justify-content: center;
      flex-wrap: wrap;
      gap: 28px;
    }
    .modern-living-section .stat-item-v2 {
      align-items: center;
      max-width: 160px;
    }
    .modern-living-section .cta-wrap {
      display: flex;
      justify-content: center;
    }
    .modern-living-section .modern-heading { font-size: 32px; }
    .modern-living-section .stat-num-v2 { font-size: 44px; }
  }

  @media (max-width: 480px) {
    .modern-living-section .modern-heading { font-size: 28px; }
    .modern-living-section .modern-desc { font-size: 16px; margin-bottom: 32px; }
    .modern-living-section .stats-row-v2 { gap: 20px; }
    .modern-living-section .stat-item-v2 { max-width: 140px; }
    .modern-living-section .modern-img { border-radius: 24px; }
  }
</style>
