<section
  id="members-around-{{ section.id }}"
  class="members-around"
  style="--ma-bg: {{ section.settings.bg_color }}; --ma-line1: {{ section.settings.line1_color }}; --ma-icon: {{ section.settings.icon_bg }}; --ma-orbit: {{ section.settings.orbit_speed | default: 40 }}s; --ma-radius: {{ section.settings.orbit_radius | default: 360 }}px;"
>
  <div class="members-around__inner">
    <div class="members-around__copy">
      {% if section.settings.heading_line1 != blank %}
        <p class="members-around__line1">{{ section.settings.heading_line1 }}</p>
      {% endif %}
      <h2 class="members-around__heading">
        {% if section.settings.heading_line2 != blank %}
          <span>{{ section.settings.heading_line2 }}</span>
        {% endif %}
        {% if section.settings.heading_line3 != blank %}
          <span>{{ section.settings.heading_line3 }}</span>
        {% endif %}
      </h2>

      <div class="members-around__socials" aria-label="Social links">
        <a href="{{ section.settings.instagram_url | default: '#' }}" class="members-around__social" {% if section.settings.instagram_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="Instagram">
          <ion-icon name="logo-instagram"></ion-icon>
        </a>
        <a href="{{ section.settings.tiktok_url | default: '#' }}" class="members-around__social" {% if section.settings.tiktok_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="TikTok">
          <ion-icon name="logo-tiktok"></ion-icon>
        </a>
        <a href="{{ section.settings.youtube_url | default: '#' }}" class="members-around__social" {% if section.settings.youtube_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="YouTube">
          <ion-icon name="logo-youtube"></ion-icon>
        </a>
        <a href="{{ section.settings.facebook_url | default: '#' }}" class="members-around__social" {% if section.settings.facebook_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="Facebook">
          <ion-icon name="logo-facebook"></ion-icon>
        </a>
      </div>
    </div>

    {%- comment -%}
      Grüns fan: pivot BELOW the cards.
      Bottoms sit close together (connected at lower edges), tops fan outward.
      Wheel turns anti-clockwise → cards rise out of the green bar on the RIGHT,
      travel across the arc, and exit into the green bar on the LEFT.
      Cards stay face-forward (2D plane only — no flip).
    {%- endcomment -%}
    <div class="members-around__stage" aria-hidden="true">
      {% assign card_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
          {% assign card_count = card_count | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if card_count == 0 %}{% assign card_count = 14 %}{% endif %}

      <div class="members-around__wheel" style="--count: {{ card_count }};">
        {% assign shown = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'card' %}
            <article
              class="members-around__card"
              style="--i: {{ shown }};"
              {{ block.shopify_attributes }}
            >
              <div class="members-around__card-face">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 700 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="700"
                    height="900"
                  >
                {% else %}
                  <div class="members-around__placeholder"><span>Add image</span></div>
                {% endif %}
              </div>
            </article>
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% if shown == 0 %}
          {% for i in (1..14) %}
            <article class="members-around__card" style="--i: {{ forloop.index0 }};">
              <div class="members-around__card-face">
                <div class="members-around__placeholder"><span>Add image</span></div>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>

  <div class="members-around__ground" aria-hidden="true"></div>
</section>

<style>
  #members-around-{{ section.id }} {
    background: var(--ma-bg, #fcf8ed);
    overflow: hidden;
    padding: clamp(56px, 7vw, 90px) 0 0;
    position: relative;
  }

  #members-around-{{ section.id }} .members-around__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  #members-around-{{ section.id }} .members-around__copy {
    text-align: center;
    padding: 0 20px;
    margin-bottom: clamp(28px, 5vw, 56px);
    position: relative;
    z-index: 2;
  }

  #members-around-{{ section.id }} .members-around__line1 {
    margin: 0 0 6px;
    font-family: 'Montserrat', sans-serif !important;
    font-weight: 900 !important;
    font-size: clamp(28px, 5.5vw, 64px) !important;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ma-line1, #007e40) !important;
  }

  #members-around-{{ section.id }} .members-around__heading,
  #members-around-{{ section.id }} h2.members-around__heading {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: 'Montserrat', sans-serif !important;
    font-weight: 900 !important;
    font-size: clamp(32px, 6.5vw, 72px) !important;
    line-height: 0.95 !important;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: #0a1f14 !important;
  }

  #members-around-{{ section.id }} .members-around__heading span {
    display: block;
    color: #0a1f14 !important;
  }

  #members-around-{{ section.id }} .members-around__socials {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: clamp(18px, 3vw, 26px);
  }

  #members-around-{{ section.id }} .members-around__social {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--ma-icon, #007e40);
    color: #fff !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  #members-around-{{ section.id }} .members-around__social:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  #members-around-{{ section.id }} .members-around__social ion-icon {
    font-size: 22px;
    color: #fff;
  }

  /*
    Stage shows only the TOP of the circle.
    Pivot sits in the green ground below → bottoms cluster & connect,
    tops fan out (Grüns hand-of-cards look).
  */
  #members-around-{{ section.id }} .members-around__stage {
    position: relative;
    width: 100%;
    height: clamp(380px, 48vw, 520px);
    overflow: hidden;
    z-index: 1;
    /* Keep the fan in the lower half — away from heading/icons */
    margin-top: clamp(12px, 2vw, 28px);
  }

  #members-around-{{ section.id }} .members-around__wheel {
    --count: 14;
    position: absolute;
    left: 50%;
    /* Hub deeper below stage → whole fan sits lower, tops stay visible */
    top: 132%;
    width: 0;
    height: 0;
    transform-origin: center center;
    animation: ma-wheel-{{ section.id }} var(--ma-orbit, 40s) linear infinite;
  }

  #members-around-{{ section.id }} .members-around__card {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(140px, 13.5vw, 190px);
    height: clamp(200px, 24vw, 300px);
    margin-left: calc(clamp(140px, 13.5vw, 190px) / -2);
    /* Anchor near the BOTTOM of the card so lower edges sit close on the arc */
    margin-top: calc(clamp(200px, 24vw, 300px) * -0.92);
    /*
      Keep radial tilt (no counter-rotate):
      bottoms hug each other near the pivot, tops fan open.
    */
    transform:
      rotate(calc(var(--i) * 360deg / var(--count)))
      translateY(calc(var(--ma-radius, 360px) * -1));
    transform-origin: center bottom;
  }

  #members-around-{{ section.id }} .members-around__card-face {
    width: 100%;
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    background: #e8efe6;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
  }

  #members-around-{{ section.id }} .members-around__card-face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #members-around-{{ section.id }} .members-around__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 28px;
    background:
      linear-gradient(145deg, rgba(0, 126, 64, 0.12), rgba(0, 126, 64, 0.28)),
      repeating-linear-gradient(
        -45deg,
        rgba(255, 255, 255, 0.35),
        rgba(255, 255, 255, 0.35) 8px,
        transparent 8px,
        transparent 16px
      );
  }

  #members-around-{{ section.id }} .members-around__placeholder span {
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #007e40 !important;
    background: rgba(255, 255, 255, 0.9);
    padding: 8px 12px;
    border-radius: 999px;
  }

  /* Green bar cards rise out of / sink into (matches next homepage section) */
  #members-around-{{ section.id }} .members-around__ground {
    position: relative;
    z-index: 2;
    height: 72px;
    margin-top: -48px;
    background: #007e40;
  }

  /* Anti-clockwise: emerge from RIGHT green edge → arc → exit LEFT */
  @keyframes ma-wheel-{{ section.id }} {
    from { transform: rotate(0deg); }
    to { transform: rotate(-360deg); }
  }

  @media (max-width: 900px) {
    #members-around-{{ section.id }} {
      --ma-radius: 200px;
    }
    #members-around-{{ section.id }} .members-around__copy {
      margin-bottom: 16px;
    }
    #members-around-{{ section.id }} .members-around__stage {
      height: clamp(420px, 70vw, 520px);
      margin-top: 4px;
    }
    #members-around-{{ section.id }} .members-around__wheel {
      top: auto;
      bottom: 0;
    }
    #members-around-{{ section.id }} .members-around__card {
      width: clamp(160px, 28vw, 210px);
      height: clamp(280px, 50vw, 380px);
      margin-left: calc(clamp(160px, 28vw, 210px) / -2);
      margin-top: calc(clamp(280px, 50vw, 380px) * -0.94);
    }
    #members-around-{{ section.id }} .members-around__ground {
      height: 52px;
      margin-top: -40px;
    }
  }

  /* Mobile — Grüns style: tall cards, ~2 visible half/half */
  @media (max-width: 600px) {
    #members-around-{{ section.id }} {
      --ma-radius: 132px;
      padding-top: 32px;
    }
    #members-around-{{ section.id }} .members-around__heading,
    #members-around-{{ section.id }} h2.members-around__heading {
      font-size: clamp(26px, 8.2vw, 34px) !important;
    }
    #members-around-{{ section.id }} .members-around__line1 {
      font-size: clamp(18px, 6vw, 26px) !important;
    }
    #members-around-{{ section.id }} .members-around__copy {
      margin-bottom: 6px;
      position: relative;
      z-index: 2;
      background: var(--ma-bg, #fcf8ed);
      padding-bottom: 2px;
    }
    #members-around-{{ section.id }} .members-around__stage {
      /* Tall enough for long cards with tops fully visible */
      height: 520px;
      margin-top: 0;
      overflow: hidden;
    }
    #members-around-{{ section.id }} .members-around__wheel {
      top: auto;
      bottom: 0;
      left: 50%;
    }
    #members-around-{{ section.id }} .members-around__card {
      /* Long portrait — about 2 cards half/half like Grüns mobile */
      width: 58vw;
      max-width: 240px;
      height: 360px;
      margin-left: calc(min(58vw, 240px) / -2);
      margin-top: calc(360px * -0.96);
      transform-origin: center bottom;
    }
    #members-around-{{ section.id }} .members-around__card-face {
      border-radius: 22px;
    }
    #members-around-{{ section.id }} .members-around__ground {
      height: 40px;
      margin-top: -28px;
    }
    #members-around-{{ section.id }} .members-around__social {
      width: 36px;
      height: 36px;
    }
    #members-around-{{ section.id }} .members-around__social ion-icon {
      font-size: 18px;
    }
    #members-around-{{ section.id }} .members-around__placeholder {
      padding-bottom: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #members-around-{{ section.id }} .members-around__wheel {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Members Getting Around",
  "tag": "section",
  "class": "section-members-around",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1 (green)",
      "default": "15,000+ FAMILIES."
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2",
      "default": "WE'VE BEEN"
    },
    {
      "type": "text",
      "id": "heading_line3",
      "label": "Heading line 3",
      "default": "GETTING AROUND"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FCF8ED"
    },
    {
      "type": "color",
      "id": "line1_color",
      "label": "Line 1 color",
      "default": "#007e40"
    },
    {
      "type": "color",
      "id": "line2_color",
      "label": "Main heading color",
      "default": "#0A1F14"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Social icon background",
      "default": "#007e40"
    },
    {
      "type": "range",
      "id": "orbit_speed",
      "label": "Orbit speed (seconds per loop)",
      "min": 24,
      "max": 70,
      "step": 2,
      "default": 40,
      "unit": "s"
    },
    {
      "type": "range",
      "id": "orbit_radius",
      "label": "Fan radius",
      "min": 240,
      "max": 480,
      "step": 10,
      "default": 360,
      "unit": "px",
      "info": "Smaller keeps cards lower under the heading"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Photo card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Members Getting Around",
      "category": "Laushe Sections",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
