<section
  id="members-around-{{ section.id }}"
  class="members-around"
  style="--ma-bg: {{ section.settings.bg_color }}; --ma-line1: {{ section.settings.line1_color }}; --ma-line2: {{ section.settings.line2_color }}; --ma-icon: {{ section.settings.icon_bg }}; --ma-orbit: {{ section.settings.orbit_speed | default: 28 }}s;"
>
  <div class="members-around__inner">
    <div class="members-around__copy">
      {% if section.settings.heading_line1 != blank %}
        <p class="members-around__line1">{{ section.settings.heading_line1 }}</p>
      {% endif %}
      <h2 class="members-around__heading">
        {% if section.settings.heading_line2 != blank %}
          <span>{{ section.settings.heading_line2 }}</span>
        {% endif %}
        {% if section.settings.heading_line3 != blank %}
          <span>{{ section.settings.heading_line3 }}</span>
        {% endif %}
      </h2>

      <div class="members-around__socials" aria-label="Social links">
        <a href="{{ section.settings.instagram_url | default: '#' }}" class="members-around__social" {% if section.settings.instagram_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="Instagram">
          <ion-icon name="logo-instagram"></ion-icon>
        </a>
        <a href="{{ section.settings.tiktok_url | default: '#' }}" class="members-around__social" {% if section.settings.tiktok_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="TikTok">
          <ion-icon name="logo-tiktok"></ion-icon>
        </a>
        <a href="{{ section.settings.youtube_url | default: '#' }}" class="members-around__social" {% if section.settings.youtube_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="YouTube">
          <ion-icon name="logo-youtube"></ion-icon>
        </a>
        <a href="{{ section.settings.facebook_url | default: '#' }}" class="members-around__social" {% if section.settings.facebook_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="Facebook">
          <ion-icon name="logo-facebook"></ion-icon>
        </a>
      </div>
    </div>

    <div class="members-around__stage" aria-hidden="true">
      <div class="members-around__orbit">
        {% assign card_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'card' %}
            {% assign card_count = card_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if card_count == 0 %}
          {% assign card_count = 6 %}
        {% endif %}
        {% assign step = 360 | divided_by: card_count %}

        {% assign shown = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'card' %}
            {% assign angle = shown | times: step %}
            {% assign tilt = block.settings.tilt | default: 0 %}
            <div
              class="members-around__card"
              style="--angle: {{ angle }}deg; --tilt: {{ tilt }}deg;"
              {{ block.shopify_attributes }}
            >
              <div class="members-around__card-face">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 700 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="700"
                    height="900"
                  >
                {% else %}
                  <div class="members-around__placeholder"><span>Add image</span></div>
                {% endif %}
              </div>
            </div>
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% if shown == 0 %}
          {% assign default_tilts = "-12,-6,0,6,12,-4" | split: "," %}
          {% for i in (1..6) %}
            {% assign ti = forloop.index0 %}
            {% assign angle = ti | times: 60 %}
            <div
              class="members-around__card"
              style="--angle: {{ angle }}deg; --tilt: {{ default_tilts[ti] }}deg;"
            >
              <div class="members-around__card-face">
                <div class="members-around__placeholder"><span>Add image</span></div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #members-around-{{ section.id }} {
    background: var(--ma-bg, #fcf8ed);
    overflow: hidden;
    padding: clamp(64px, 8vw, 100px) 0 0;
    position: relative;
  }

  #members-around-{{ section.id }} .members-around__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  #members-around-{{ section.id }} .members-around__copy {
    text-align: center;
    padding: 0 20px;
    margin-bottom: clamp(20px, 3vw, 36px);
    position: relative;
    z-index: 2;
  }

  #members-around-{{ section.id }} .members-around__line1 {
    margin: 0 0 6px;
    font-family: 'Montserrat', sans-serif !important;
    font-weight: 900 !important;
    font-size: clamp(28px, 5.5vw, 64px) !important;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ma-line1, #007e40) !important;
  }

  #members-around-{{ section.id }} .members-around__heading,
  #members-around-{{ section.id }} h2.members-around__heading {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    font-family: 'Montserrat', sans-serif !important;
    font-weight: 900 !important;
    font-size: clamp(32px, 6.5vw, 72px) !important;
    line-height: 0.95 !important;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: #0a1f14 !important;
  }

  #members-around-{{ section.id }} .members-around__heading span {
    display: block;
    color: #0a1f14 !important;
  }

  #members-around-{{ section.id }} .members-around__socials {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: clamp(22px, 3vw, 32px);
  }

  #members-around-{{ section.id }} .members-around__social {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--ma-icon, #007e40);
    color: #fff !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  #members-around-{{ section.id }} .members-around__social:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  #members-around-{{ section.id }} .members-around__social ion-icon {
    font-size: 22px;
    color: #fff;
  }

  /* Orbit stage — front arc of a 3D ring */
  #members-around-{{ section.id }} .members-around__stage {
    position: relative;
    width: 100%;
    height: clamp(300px, 46vw, 480px);
    overflow: hidden;
    perspective: 1400px;
    perspective-origin: 50% 40%;
    -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 50%, transparent 100%);
  }

  #members-around-{{ section.id }} .members-around__orbit {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    animation: ma-orbit-{{ section.id }} var(--ma-orbit, 28s) linear infinite;
  }

  #members-around-{{ section.id }} .members-around__card {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(150px, 17vw, 230px);
    height: clamp(210px, 25vw, 330px);
    margin-left: calc(clamp(150px, 17vw, 230px) / -2);
    margin-top: calc(clamp(210px, 25vw, 330px) / -2);
    transform-style: preserve-3d;
    transform: rotateY(var(--angle)) translateZ(clamp(220px, 34vw, 460px));
  }

  #members-around-{{ section.id }} .members-around__card-face {
    width: 100%;
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    background: #e8efe6;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
    animation: ma-counter-{{ section.id }} var(--ma-orbit, 28s) linear infinite;
  }

  #members-around-{{ section.id }} .members-around__card-face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #members-around-{{ section.id }} .members-around__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(145deg, rgba(0, 126, 64, 0.12), rgba(0, 126, 64, 0.28)),
      repeating-linear-gradient(
        -45deg,
        rgba(255, 255, 255, 0.35),
        rgba(255, 255, 255, 0.35) 8px,
        transparent 8px,
        transparent 16px
      );
  }

  #members-around-{{ section.id }} .members-around__placeholder span {
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #007e40 !important;
    background: rgba(255, 255, 255, 0.9);
    padding: 8px 12px;
    border-radius: 999px;
  }

  /* Anti-clockwise orbit (negative Y) */
  @keyframes ma-orbit-{{ section.id }} {
    from { transform: rotateY(0deg); }
    to { transform: rotateY(-360deg); }
  }

  /* Keep card faces pointed at the camera while ring orbits */
  @keyframes ma-counter-{{ section.id }} {
    from { transform: rotateY(calc(var(--angle) * -1)) rotateZ(var(--tilt, 0deg)); }
    to { transform: rotateY(calc(var(--angle) * -1 + 360deg)) rotateZ(var(--tilt, 0deg)); }
  }

  @media (max-width: 900px) {
    #members-around-{{ section.id }} .members-around__stage {
      height: clamp(260px, 62vw, 360px);
      perspective: 1000px;
    }
    #members-around-{{ section.id }} .members-around__card {
      width: clamp(120px, 26vw, 170px);
      height: clamp(170px, 38vw, 250px);
      margin-left: calc(clamp(120px, 26vw, 170px) / -2);
      margin-top: calc(clamp(170px, 38vw, 250px) / -2);
      transform: rotateY(var(--angle)) translateZ(clamp(160px, 42vw, 260px));
    }
  }

  @media (max-width: 600px) {
    #members-around-{{ section.id }} {
      padding-top: 56px;
    }
    #members-around-{{ section.id }} .members-around__heading,
    #members-around-{{ section.id }} h2.members-around__heading {
      font-size: clamp(28px, 9vw, 40px) !important;
    }
    #members-around-{{ section.id }} .members-around__line1 {
      font-size: clamp(22px, 7vw, 32px) !important;
    }
    #members-around-{{ section.id }} .members-around__social {
      width: 38px;
      height: 38px;
      border-radius: 9px;
    }
    #members-around-{{ section.id }} .members-around__social ion-icon {
      font-size: 20px;
    }
    #members-around-{{ section.id }} .members-around__orbit {
      top: 55%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #members-around-{{ section.id }} .members-around__orbit,
    #members-around-{{ section.id }} .members-around__card-face {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Members Getting Around",
  "tag": "section",
  "class": "section-members-around",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1 (green)",
      "default": "15,000+ FAMILIES."
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2",
      "default": "WE'VE BEEN"
    },
    {
      "type": "text",
      "id": "heading_line3",
      "label": "Heading line 3",
      "default": "GETTING AROUND"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FCF8ED"
    },
    {
      "type": "color",
      "id": "line1_color",
      "label": "Line 1 color",
      "default": "#007e40"
    },
    {
      "type": "color",
      "id": "line2_color",
      "label": "Main heading color",
      "default": "#0A1F14"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Social icon background",
      "default": "#007e40"
    },
    {
      "type": "range",
      "id": "orbit_speed",
      "label": "Orbit speed (seconds per loop)",
      "min": 12,
      "max": 60,
      "step": 2,
      "default": 28,
      "unit": "s"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Photo card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "range",
          "id": "tilt",
          "label": "Card tilt",
          "min": -16,
          "max": 16,
          "step": 1,
          "default": 0,
          "unit": "deg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Members Getting Around",
      "category": "Laushe Sections",
      "blocks": [
        { "type": "card", "settings": { "tilt": -12 } },
        { "type": "card", "settings": { "tilt": -6 } },
        { "type": "card", "settings": { "tilt": 0 } },
        { "type": "card", "settings": { "tilt": 6 } },
        { "type": "card", "settings": { "tilt": 12 } },
        { "type": "card", "settings": { "tilt": -4 } }
      ]
    }
  ]
}
{% endschema %}
