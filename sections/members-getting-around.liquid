<section
  id="members-around-{{ section.id }}"
  class="members-around"
  style="--ma-bg: {{ section.settings.bg_color }}; --ma-line1: {{ section.settings.line1_color }}; --ma-line2: {{ section.settings.line2_color }}; --ma-icon: {{ section.settings.icon_bg }}; --ma-orbit: {{ section.settings.orbit_speed | default: 32 }}s;"
>
  <div class="members-around__inner">
    <div class="members-around__copy">
      {% if section.settings.heading_line1 != blank %}
        <p class="members-around__line1">{{ section.settings.heading_line1 }}</p>
      {% endif %}
      <h2 class="members-around__heading">
        {% if section.settings.heading_line2 != blank %}
          <span>{{ section.settings.heading_line2 }}</span>
        {% endif %}
        {% if section.settings.heading_line3 != blank %}
          <span>{{ section.settings.heading_line3 }}</span>
        {% endif %}
      </h2>

      <div class="members-around__socials" aria-label="Social links">
        <a href="{{ section.settings.instagram_url | default: '#' }}" class="members-around__social" {% if section.settings.instagram_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="Instagram">
          <ion-icon name="logo-instagram"></ion-icon>
        </a>
        <a href="{{ section.settings.tiktok_url | default: '#' }}" class="members-around__social" {% if section.settings.tiktok_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="TikTok">
          <ion-icon name="logo-tiktok"></ion-icon>
        </a>
        <a href="{{ section.settings.youtube_url | default: '#' }}" class="members-around__social" {% if section.settings.youtube_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="YouTube">
          <ion-icon name="logo-youtube"></ion-icon>
        </a>
        <a href="{{ section.settings.facebook_url | default: '#' }}" class="members-around__social" {% if section.settings.facebook_url != blank %}target="_blank" rel="noopener"{% endif %} aria-label="Facebook">
          <ion-icon name="logo-facebook"></ion-icon>
        </a>
      </div>
    </div>

    {%- comment -%}
      Cards travel on a circular path: enter from RIGHT → stay FRONT-facing → exit LEFT (continuous loop).
    {%- endcomment -%}
    <div class="members-around__stage" aria-hidden="true">
      {% assign card_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
          {% assign card_count = card_count | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if card_count == 0 %}{% assign card_count = 6 %}{% endif %}

      <div class="members-around__rail" style="--count: {{ card_count }};">
        {% assign shown = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'card' %}
            {% assign tilt = block.settings.tilt | default: 0 %}
            <article
              class="members-around__card"
              style="--i: {{ shown }}; --tilt: {{ tilt }}deg;"
              {{ block.shopify_attributes }}
            >
              <div class="members-around__card-face">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 700 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="700"
                    height="900"
                  >
                {% else %}
                  <div class="members-around__placeholder"><span>Add image</span></div>
                {% endif %}
              </div>
            </article>
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% if shown == 0 %}
          {% assign default_tilts = "-14,-8,-2,4,10,-10" | split: "," %}
          {% for i in (1..6) %}
            {% assign ti = forloop.index0 %}
            <article class="members-around__card" style="--i: {{ ti }}; --tilt: {{ default_tilts[ti] }}deg;">
              <div class="members-around__card-face">
                <div class="members-around__placeholder"><span>Add image</span></div>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #members-around-{{ section.id }} {
    background: var(--ma-bg, #fcf8ed);
    overflow: hidden;
    padding: clamp(64px, 8vw, 100px) 0 0;
    position: relative;
  }

  #members-around-{{ section.id }} .members-around__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  #members-around-{{ section.id }} .members-around__copy {
    text-align: center;
    padding: 0 20px;
    margin-bottom: clamp(12px, 2vw, 24px);
    position: relative;
    z-index: 2;
  }

  #members-around-{{ section.id }} .members-around__line1 {
    margin: 0 0 6px;
    font-family: 'Montserrat', sans-serif !important;
    font-weight: 900 !important;
    font-size: clamp(28px, 5.5vw, 64px) !important;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ma-line1, #007e40) !important;
  }

  #members-around-{{ section.id }} .members-around__heading,
  #members-around-{{ section.id }} h2.members-around__heading {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: 'Montserrat', sans-serif !important;
    font-weight: 900 !important;
    font-size: clamp(32px, 6.5vw, 72px) !important;
    line-height: 0.95 !important;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: #0a1f14 !important;
  }

  #members-around-{{ section.id }} .members-around__heading span {
    display: block;
    color: #0a1f14 !important;
  }

  #members-around-{{ section.id }} .members-around__socials {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: clamp(22px, 3vw, 32px);
  }

  #members-around-{{ section.id }} .members-around__social {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--ma-icon, #007e40);
    color: #fff !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  #members-around-{{ section.id }} .members-around__social:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  #members-around-{{ section.id }} .members-around__social ion-icon {
    font-size: 22px;
    color: #fff;
  }

  /* Visible window — only the front/bottom arc of the orbit */
  #members-around-{{ section.id }} .members-around__stage {
    position: relative;
    width: 100%;
    height: clamp(300px, 48vw, 500px);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 42%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 42%, transparent 100%);
  }

  #members-around-{{ section.id }} .members-around__rail {
    position: absolute;
    inset: 0;
  }

  /*
    Circular orbit:
    - Path center sits above the stage so cards travel the bottom arc
    - offset-rotate: 0deg keeps every card FACE toward the viewer (never spins on its own axis)
    - Animation: RIGHT → FRONT → LEFT → around the back → RIGHT again
  */
  #members-around-{{ section.id }} .members-around__card {
    position: absolute;
    top: 8%;
    left: 50%;
    width: clamp(150px, 17vw, 230px);
    height: clamp(210px, 25vw, 330px);
    margin-left: calc(clamp(150px, 17vw, 230px) / -2);
    offset-path: circle(clamp(240px, 38vw, 520px) at 50% 0%);
    offset-anchor: center center;
    offset-rotate: 0deg;
    offset-distance: 0%;
    transform: rotate(var(--tilt, 0deg));
    animation: ma-orbit-acw-{{ section.id }} var(--ma-orbit, 32s) linear infinite;
    animation-delay: calc((var(--i) / var(--count, 6)) * var(--ma-orbit, 32s) * -1);
    will-change: offset-distance;
  }

  #members-around-{{ section.id }} .members-around__card-face {
    width: 100%;
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    background: #e8efe6;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
  }

  #members-around-{{ section.id }} .members-around__card-face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #members-around-{{ section.id }} .members-around__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(145deg, rgba(0, 126, 64, 0.12), rgba(0, 126, 64, 0.28)),
      repeating-linear-gradient(
        -45deg,
        rgba(255, 255, 255, 0.35),
        rgba(255, 255, 255, 0.35) 8px,
        transparent 8px,
        transparent 16px
      );
  }

  #members-around-{{ section.id }} .members-around__placeholder span {
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #007e40 !important;
    background: rgba(255, 255, 255, 0.9);
    padding: 8px 12px;
    border-radius: 999px;
  }

  /*
    Anti-clockwise around the circle (center above):
    along the visible bottom arc this reads as RIGHT → FRONT → LEFT.
  */
  @keyframes ma-orbit-acw-{{ section.id }} {
    from { offset-distance: 0%; }
    to { offset-distance: 100%; }
  }

  @media (max-width: 900px) {
    #members-around-{{ section.id }} .members-around__stage {
      height: clamp(260px, 64vw, 380px);
    }
    #members-around-{{ section.id }} .members-around__card {
      width: clamp(120px, 28vw, 170px);
      height: clamp(170px, 40vw, 250px);
      margin-left: calc(clamp(120px, 28vw, 170px) / -2);
      offset-path: circle(clamp(170px, 48vw, 280px) at 50% 0%);
    }
  }

  @media (max-width: 600px) {
    #members-around-{{ section.id }} {
      padding-top: 56px;
    }
    #members-around-{{ section.id }} .members-around__heading,
    #members-around-{{ section.id }} h2.members-around__heading {
      font-size: clamp(28px, 9vw, 40px) !important;
    }
    #members-around-{{ section.id }} .members-around__line1 {
      font-size: clamp(22px, 7vw, 32px) !important;
    }
    #members-around-{{ section.id }} .members-around__social {
      width: 38px;
      height: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #members-around-{{ section.id }} .members-around__card {
      animation: none;
      offset-distance: calc(18% + (var(--i) * 10%));
    }
  }
</style>

{% schema %}
{
  "name": "Members Getting Around",
  "tag": "section",
  "class": "section-members-around",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1 (green)",
      "default": "15,000+ FAMILIES."
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2",
      "default": "WE'VE BEEN"
    },
    {
      "type": "text",
      "id": "heading_line3",
      "label": "Heading line 3",
      "default": "GETTING AROUND"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FCF8ED"
    },
    {
      "type": "color",
      "id": "line1_color",
      "label": "Line 1 color",
      "default": "#007e40"
    },
    {
      "type": "color",
      "id": "line2_color",
      "label": "Main heading color",
      "default": "#0A1F14"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Social icon background",
      "default": "#007e40"
    },
    {
      "type": "range",
      "id": "orbit_speed",
      "label": "Orbit speed (seconds per loop)",
      "min": 16,
      "max": 60,
      "step": 2,
      "default": 32,
      "unit": "s"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Photo card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "range",
          "id": "tilt",
          "label": "Card tilt",
          "min": -16,
          "max": 16,
          "step": 1,
          "default": 0,
          "unit": "deg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Members Getting Around",
      "category": "Laushe Sections",
      "blocks": [
        { "type": "card", "settings": { "tilt": -14 } },
        { "type": "card", "settings": { "tilt": -8 } },
        { "type": "card", "settings": { "tilt": -2 } },
        { "type": "card", "settings": { "tilt": 4 } },
        { "type": "card", "settings": { "tilt": 10 } },
        { "type": "card", "settings": { "tilt": -10 } }
      ]
    }
  ]
}
{% endschema %}
