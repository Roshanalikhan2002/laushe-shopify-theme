{% schema %}
{
  "name": "Ingredients Grid",
  "settings": [
    { "id": "headline", "type": "text", "label": "Headline", "default": "High-Quality, Natural Ingredients" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "id": "title", "type": "text", "label": "Name", "default": "Dried Hibiscus" },
        { "id": "desc", "type": "textarea", "label": "Function", "default": "Helps with fat reduction and digestion." }
      ]
    }
  ],
  "presets": [{ "name": "Ingredients Grid", "category": "Luxe Funnel" }]
}
{% endschema %}

<section class="ingredients-section section-padding bg-white">
  <div class="container-wide ingredients-inner">
    <h2 class="ingredients-headline h1 text-center">{{ section.settings.headline }}</h2>
    <div class="ingredients-grid">
      {% for block in section.blocks %}
        <div class="ingredient-item">
          <div class="ing-icon">
            <ion-icon name="leaf-outline"></ion-icon>
          </div>
          <div class="ing-content">
            <h3 class="ing-title">{{ block.settings.title }}</h3>
            <p class="ing-desc">{{ block.settings.desc }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .ingredients-section.section-padding {
    padding-top: 24px;
    padding-bottom: 80px;
  }
  .ingredients-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .ingredients-headline {
    font-size: clamp(28px, 5vw, 44px);
    text-align: center;
    margin: 0 0 40px;
    color: #007E40;
    font-weight: 800;
    font-family: 'Poppins', sans-serif;
  }
  .ingredients-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .ingredient-item { display: flex; gap: 24px; align-items: flex-start; padding: 32px; border-radius: 20px; border: 1px solid #f0f0f0; transition: all 0.3s ease; background: #FEF9E1; }
  .ingredient-item:hover { border-color: #007E40; box-shadow: 0 10px 40px rgba(0,126,64,0.08); transform: translateY(-3px); }
  .ing-icon { background: #f0faf4; width: 60px; height: 60px; min-width: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 28px; color: #007E40; }
  .ing-title { font-size: 19px; font-weight: 800; color: #007E40; margin-bottom: 10px; font-family: 'Poppins', sans-serif; }
  .ing-desc { color: #666; font-size: 14px; line-height: 1.6; }
  @media (max-width: 768px) {
    .ingredients-section.section-padding {
      padding-top: 8px;
      padding-bottom: 48px;
    }
    .ingredients-inner { padding: 0 20px; }
    .ingredients-headline { margin-bottom: 28px; }
    .ingredients-grid { grid-template-columns: 1fr; }
  }
</style>

