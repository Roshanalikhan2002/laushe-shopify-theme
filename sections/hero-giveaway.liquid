<section class="hero-giveaway">
  <div class="hero-giveaway__container">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="hero-giveaway__link">
    {% endif %}

    <div class="hero-giveaway__image-wrapper">
      <img
        src="{{ 'hero-banner-web-v2.jpg' | asset_url }}"
        alt="Laushé — Wellness Never Tasted So Good"
        class="hero-giveaway__image desktop-only"
        width="1920"
        height="700"
        loading="eager"
      >
      <img
        src="{{ 'hero-banner-mobile-v2.jpg' | asset_url }}"
        alt="Laushé — Wellness Never Tasted So Good"
        class="hero-giveaway__image mobile-only"
        width="1080"
        height="1080"
        loading="eager"
      >
    </div>

    {% if section.settings.link != blank %}
      </a>
    {% endif %}
  </div>

  {%- comment -%} Quality strip — always directly under banner {%- endcomment -%}
  <div class="banner-quality-strip">
    <div class="container text-center">
      <p class="banner-quality-strip__text">
        {{ section.settings.strip_text | default: 'Our products are regularly tested to ensure purity and authenticity.' }}
      </p>
      <div class="banner-quality-strip__grid">
        <div class="banner-quality-strip__item">
          <div class="banner-quality-strip__icon">{% render 'icon-laushe', name: 'beaker' %}</div>
          <h3>No Pesticides</h3>
        </div>
        <div class="banner-quality-strip__item">
          <div class="banner-quality-strip__icon">{% render 'icon-laushe', name: 'skull' %}</div>
          <h3>No Heavy Metals</h3>
        </div>
        <div class="banner-quality-strip__item">
          <div class="banner-quality-strip__icon">{% render 'icon-laushe', name: 'leaf' %}</div>
          <h3>100% Organic</h3>
        </div>
        <div class="banner-quality-strip__item">
          <div class="banner-quality-strip__icon">{% render 'icon-laushe', name: 'globe' %}</div>
          <h3>Ethically Sourced</h3>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Bestsellers — always directly under strip {%- endcomment -%}
  <div class="bs-products" id="laushe-bestsellers">
    <div class="container text-center">
      <h2 class="bs-heading">{{ section.settings.bs_heading | default: 'Our Top Bestsellers' }}</h2>
      {% if section.settings.bs_subheading != blank %}
        <p class="bs-subheading">{{ section.settings.bs_subheading }}</p>
      {% endif %}

      <div class="bs-grid">
        {% assign shown = 0 %}
        {% assign pastel_bgs = "#F3E6E0,#E4EFE8,#F0EADF,#E8F1F4,#F5EDE3,#E9F0E6" | split: "," %}
        {% assign bs_priority_handles = "skinny-sips-weight-loss-kehwa,royce-hair-oil-sunnah-blessed,skin-tint,liquid-blush" | split: "," %}
        {% for block in section.blocks %}
          {% if block.type == 'product' %}
            {% assign prod = all_products[block.settings.product] %}
            {% if prod != blank %}
              {% assign shown = shown | plus: 1 %}
              {% assign bg = block.settings.card_bg | default: pastel_bgs[forloop.index0] %}
              <article class="bs-card" {{ block.shopify_attributes }}>
                <div class="bs-media" style="background: {{ bg }};">
                  {% if block.settings.show_badge and block.settings.badge_text != blank %}
                    <span class="bs-badge">{{ block.settings.badge_text }}</span>
                  {% endif %}
                  <a href="{{ prod.url }}" class="bs-img-link">
                    {% if block.settings.image_override != blank %}
                      <img src="{{ block.settings.image_override | image_url: width: 700 }}" alt="{{ block.settings.title_override | default: prod.title | escape }}">
                    {% elsif prod.featured_image %}
                      <img src="{{ prod.featured_image | image_url: width: 700 }}" alt="{{ prod.title | escape }}">
                    {% else %}
                      <span class="bs-placeholder">Add image</span>
                    {% endif %}
                  </a>
                </div>
                <div class="bs-content">
                  <h3 class="bs-title"><a href="{{ prod.url }}">{{ block.settings.title_override | default: prod.title }}</a></h3>
                  <div class="bs-stars">
                    <span class="bs-stars-gold">★★★★★</span>
                    <span class="bs-rating">{{ block.settings.rating }}</span>
                    <span class="bs-reviews">({{ block.settings.stars_count }})</span>
                  </div>
                  <div class="bs-price-row">
                    <span class="bs-price">{{ prod.price | money }}</span>
                    {% if prod.compare_at_price > prod.price %}
                      <span class="bs-compare">{{ prod.compare_at_price | money }}</span>
                    {% endif %}
                  </div>
                  <a href="{{ prod.url }}" class="bs-shop-now">SHOP NOW</a>
                </div>
              </article>
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if shown == 0 %}
          {% for p_handle in bs_priority_handles %}
            {% assign prod = all_products[p_handle] %}
            {% if prod != blank %}
              {% assign shown = shown | plus: 1 %}
              {% assign bg_i = forloop.index0 | modulo: 6 %}
              <article class="bs-card">
                <div class="bs-media" style="background: {{ pastel_bgs[bg_i] }};">
                  <span class="bs-badge">BESTSELLER</span>
                  <a href="{{ prod.url }}" class="bs-img-link">
                    {% if prod.featured_image %}
                      <img src="{{ prod.featured_image | image_url: width: 700 }}" alt="{{ prod.title | escape }}">
                    {% else %}
                      <span class="bs-placeholder">Add image</span>
                    {% endif %}
                  </a>
                </div>
                <div class="bs-content">
                  <h3 class="bs-title"><a href="{{ prod.url }}">{{ prod.title }}</a></h3>
                  <div class="bs-stars">
                    <span class="bs-stars-gold">★★★★★</span>
                    <span class="bs-rating">4.8</span>
                  </div>
                  <div class="bs-price-row">
                    <span class="bs-price">{{ prod.price | money }}</span>
                    {% if prod.compare_at_price > prod.price %}
                      <span class="bs-compare">{{ prod.compare_at_price | money }}</span>
                    {% endif %}
                  </div>
                  <a href="{{ prod.url }}" class="bs-shop-now">SHOP NOW</a>
                </div>
              </article>
            {% endif %}
          {% endfor %}
          {% if shown == 0 %}
            <div class="bs-empty">
              <h3>No products yet</h3>
              <p>Add products in Theme Editor under Giveaway Hero Banner.</p>
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.hero-giveaway {
  width: 100%;
  display: block;
  background: #007e40;
  margin: 0 !important;
  padding: 0 !important;
}
.hero-giveaway__container {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  background: #a8b89a;
  overflow: visible;
}
.hero-giveaway__image-wrapper {
  width: 100%;
  display: block;
  line-height: 0;
  overflow: visible;
}
.hero-giveaway__image {
  width: 100%;
  max-width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
  object-position: center;
}
.placeholder-svg {
  background-color: #e3e3e3;
  width: 100%;
  height: 400px;
}
.desktop-only { display: block; }
.mobile-only { display: none; }

.banner-quality-strip {
  background: #007e40;
  padding: 48px 0 40px;
  margin: 0;
  border-bottom: 1px solid rgba(255,255,255,0.18);
}
.banner-quality-strip__text {
  color: #ffffff;
  font-size: clamp(16px, 2.2vw, 20px);
  font-weight: 700;
  max-width: 720px;
  margin: 0 auto 36px;
  line-height: 1.45;
}
.banner-quality-strip__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  max-width: 1100px;
  margin: 0 auto;
}
.banner-quality-strip__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
}
.banner-quality-strip__icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  border: 2px solid #ffcc33;
  display: flex;
  align-items: center;
  justify-content: center;
}
.banner-quality-strip__icon svg {
  width: 36px;
  height: 36px;
  color: #ffcc33;
}
.banner-quality-strip__item h3 {
  margin: 0;
  color: #ffffff !important;
  font-size: 16px;
  font-weight: 800;
  font-family: 'Montserrat', sans-serif;
}

/* Scoped under .bs-products so white text does not leak into the separate bestsellers section */
.bs-products { padding: 48px 0 80px; background: #007e40; }
.bs-products .bs-heading {
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(40px, 6vw, 64px);
  font-weight: 900;
  color: #ffffff !important;
  margin: 0 0 12px;
  letter-spacing: -0.03em;
  line-height: 1.05;
}
.bs-products .bs-subheading {
  color: #ffffff;
  font-size: 16px;
  margin: 0 auto 48px;
  max-width: 560px;
}
.bs-products .bs-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 28px;
  text-align: left;
}
.bs-products .bs-card { display: flex; flex-direction: column; height: 100%; }
.bs-products .bs-content { display: flex; flex-direction: column; flex: 1; }
.bs-products .bs-media {
  position: relative;
  border-radius: 28px;
  overflow: hidden;
  aspect-ratio: 1 / 1.05;
  margin-bottom: 18px;
}
.bs-products .bs-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  z-index: 2;
  background: #ffcc33;
  color: #000000;
  font-size: 11px;
  font-weight: 800;
  padding: 6px 12px;
  border-radius: 999px;
  font-family: 'Montserrat', sans-serif;
}
.bs-products .bs-img-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 0;
  box-sizing: border-box;
  background: #ffffff;
  border: 3px solid #ffffff;
  border-radius: 28px;
}
.bs-products .bs-img-link img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
  transition: transform 0.4s ease;
}
.bs-products .bs-card:hover .bs-img-link img { transform: scale(1.04); }
.bs-products .bs-placeholder { color: #000000; font-weight: 600; }
.bs-products .bs-title {
  font-family: 'Montserrat', sans-serif;
  font-size: 18px;
  font-weight: 800;
  margin: 0 0 8px;
  line-height: 1.25;
  min-height: 45px;
  display: flex;
  align-items: flex-start;
}
.bs-products .bs-title a { color: #ffffff !important; text-decoration: none; }
.bs-products .bs-stars { display: flex; align-items: center; gap: 6px; margin-bottom: 10px; }
.bs-products .bs-stars-gold { color: #ffcc33; letter-spacing: 1px; font-size: 13px; }
.bs-products .bs-rating { font-weight: 700; font-size: 13px; color: #ffffff; }
.bs-products .bs-reviews { color: #ffffff; font-size: 13px; }
.bs-products .bs-price-row { display: flex; gap: 10px; align-items: center; margin-bottom: 16px; }
.bs-products .bs-price { font-weight: 800; font-size: 16px; color: #ffcc33; }
.bs-products .bs-compare { color: #ffffff; text-decoration: line-through; font-size: 14px; }
.bs-products .bs-shop-now {
  margin-top: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 14px 18px;
  border-radius: 999px;
  border: 1.5px solid #ffcc33;
  background: #ffcc33;
  color: #000000;
  text-decoration: none;
  font-weight: 700;
  font-size: 13px;
  letter-spacing: 0.08em;
  font-family: 'Montserrat', sans-serif;
  transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
}
.bs-products .bs-shop-now:hover {
  background: transparent;
  border-color: #ffffff;
  color: #fff;
}
.bs-products .bs-empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 40px;
  color: #ffffff;
}

@media screen and (max-width: 900px) {
  .bs-products .bs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .banner-quality-strip__grid { grid-template-columns: repeat(2, 1fr); }
}
@media screen and (max-width: 768px) {
  .desktop-only { display: none; }
  .mobile-only { display: block; }
}
@media screen and (max-width: 600px) {
  .bs-products .bs-grid { grid-template-columns: 1fr; }
  .banner-quality-strip { padding: 36px 0 28px; }
  .bs-products { padding: 32px 0 56px; }
}
</style>

{% schema %}
{
  "name": "Giveaway Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Giveaway Image (Desktop/Default)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Giveaway Image (Mobile)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner Link"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Quality strip text",
      "default": "Our products are regularly tested to ensure purity and authenticity."
    },
    {
      "type": "text",
      "id": "bs_heading",
      "label": "Bestsellers heading",
      "default": "Our Top Bestsellers"
    },
    {
      "type": "text",
      "id": "bs_subheading",
      "label": "Bestsellers subheading",
      "default": "Customer favorites — Skinny Sips, Hair Oil, Skin Tint & Liquid Blush."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "limit": 4,
      "settings": [
        { "id": "product", "type": "product", "label": "Select Product" },
        { "id": "title_override", "type": "text", "label": "Custom Title (Optional)" },
        { "id": "image_override", "type": "image_picker", "label": "Custom Image (Optional)" },
        { "id": "stars_count", "type": "text", "label": "Review Count", "default": "1250" },
        { "id": "rating", "type": "text", "label": "Rating", "default": "4.8" },
        { "id": "show_badge", "type": "checkbox", "label": "Show Sale Badge", "default": true },
        { "id": "badge_text", "type": "text", "label": "Badge Text", "default": "BESTSELLER" },
        { "id": "card_bg", "type": "color", "label": "Image background", "default": "#E4EFE8" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Giveaway Hero Banner"
    }
  ]
}
{% endschema %}
