<section class="hero-giveaway">
  <div class="hero-giveaway__container">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="hero-giveaway__link">
    {% endif %}
    
    <div class="hero-giveaway__image-wrapper">
      {% if section.settings.image_desktop != blank %}
        <img src="{{ section.settings.image_desktop | image_url }}" 
             alt="{{ section.settings.image_desktop.alt | escape }}" 
             class="hero-giveaway__image desktop-only" loading="lazy">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hero-giveaway__image desktop-only' }}
      {% endif %}

      {% if section.settings.image_mobile != blank %}
        <img src="{{ section.settings.image_mobile | image_url }}" 
             alt="{{ section.settings.image_mobile.alt | escape }}" 
             class="hero-giveaway__image mobile-only" loading="lazy">
      {% endif %}
    </div>

    {% if section.settings.link != blank %}
      </a>
    {% endif %}
  </div>
</section>

<!-- Quality strip: only once, directly under hero banner -->
<section class="banner-quality-strip">
  <div class="container text-center">
    <p class="banner-quality-strip__text">Our products are regularly tested to ensure purity and authenticity.</p>
    <div class="banner-quality-strip__grid">
      <div class="banner-quality-strip__item">
        <div class="banner-quality-strip__icon">{% render 'icon-laushe', name: 'beaker' %}</div>
        <h3>No Pesticides</h3>
      </div>
      <div class="banner-quality-strip__item">
        <div class="banner-quality-strip__icon">{% render 'icon-laushe', name: 'skull' %}</div>
        <h3>No Heavy Metals</h3>
      </div>
      <div class="banner-quality-strip__item">
        <div class="banner-quality-strip__icon">{% render 'icon-laushe', name: 'leaf' %}</div>
        <h3>100% Organic</h3>
      </div>
      <div class="banner-quality-strip__item">
        <div class="banner-quality-strip__icon">{% render 'icon-laushe', name: 'globe' %}</div>
        <h3>Ethically Sourced</h3>
      </div>
    </div>
  </div>
</section>

<style>
.hero-giveaway {
  width: 100%;
  display: block;
  background-color: #ffffff;
  margin-bottom: 0 !important;
}
.hero-giveaway__container {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
}
.hero-giveaway__image-wrapper {
  width: 100%;
  display: block;
}
.hero-giveaway__image {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
}
.placeholder-svg {
  background-color: #e3e3e3;
  width: 100%;
  height: 400px;
}
.desktop-only {
  display: block;
}
.mobile-only {
  display: none;
}
.banner-quality-strip {
  background: #007e40;
  padding: 48px 0 56px;
  margin: 0 0 40px !important;
}
.banner-quality-strip__text {
  color: #ffffff;
  font-size: clamp(16px, 2.2vw, 20px);
  font-weight: 700;
  max-width: 720px;
  margin: 0 auto 36px;
  line-height: 1.45;
}
.banner-quality-strip__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  max-width: 1100px;
  margin: 0 auto;
}
.banner-quality-strip__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
}
.banner-quality-strip__icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  border: 2px solid #ffcc33;
  display: flex;
  align-items: center;
  justify-content: center;
}
.banner-quality-strip__icon svg {
  width: 36px;
  height: 36px;
  color: #ffcc33;
}
.banner-quality-strip__item h3 {
  margin: 0;
  color: #ffffff !important;
  font-size: 16px;
  font-weight: 800;
  font-family: 'Nunito', sans-serif;
}
@media screen and (max-width: 768px) {
  {% if section.settings.image_mobile != blank %}
    .desktop-only {
      display: none;
    }
    .mobile-only {
      display: block;
    }
  {% endif %}
  .banner-quality-strip__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 16px;
  }
  .banner-quality-strip {
    padding: 36px 0 40px;
  }
}
</style>

{% schema %}
{
  "name": "Giveaway Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Giveaway Image (Desktop/Default)",
      "info": "Upload your giveaway banner image here."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Giveaway Image (Mobile)",
      "info": "Optional: Upload a different image dimension for mobile devices."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner Link",
      "info": "Where should users go when they click the banner?"
    }
  ],
  "presets": [
    {
      "name": "Giveaway Hero Banner"
    }
  ]
}
{% endschema %}
