<div class="password-page" style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:40px 20px;font-family:Inter,Poppins,sans-serif;text-align:center;">
  <div style="width:min(420px,92vw);">
    <h1 style="color:#004225;font-size:28px;margin:0 0 12px;">{{ section.settings.heading }}</h1>
    <p style="color:#666;font-size:15px;margin:0 0 28px;">{{ section.settings.subtext }}</p>

    {% form 'storefront_password' %}
      {% if form.errors %}
        <div style="color:#b00020;margin-bottom:12px;">{{ form.errors | default_errors }}</div>
      {% endif %}
      <input
        type="password"
        name="password"
        id="Password"
        placeholder="Enter store password"
        autocomplete="current-password"
        autofocus
        style="width:100%;box-sizing:border-box;padding:14px 16px;border:1px solid #ddd;border-radius:10px;font-size:16px;margin-bottom:12px;"
      >
      <button type="submit" style="width:100%;padding:14px 16px;border:0;border-radius:10px;background:#004225;color:#fff;font-size:15px;font-weight:600;cursor:pointer;">
        Enter
      </button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Password form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Laushe Redesign is Launching Soon"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Enter the store password to continue."
    }
  ]
}
{% endschema %}