{% schema %}
{
  "name": "Our Story (Laushe)",
  "settings": [
    { "id": "bg_color", "type": "color", "label": "Background Color", "default": "#FEF9E1" },
    { "id": "subtitle", "type": "text", "label": "Subtitle", "default": "OUR STORY" },
    { "id": "title", "type": "text", "label": "Title", "default": "Rooted in Tradition, Crafted with Love" },
    { "id": "description_1", "type": "textarea", "label": "Description Paragraph 1", "default": "Laushe was born from a simple belief: that the best health solutions come from nature itself." },
    { "id": "description_2", "type": "textarea", "label": "Description Paragraph 2", "default": "We source our ingredients directly from trusted farms, ensuring every product meets the highest standards." },
    { "id": "image", "type": "image_picker", "label": "Story Image" },
    { "id": "badge_text", "type": "text", "label": "Badge Text", "default": "Est. 2024" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Story Stat",
      "limit": 3,
      "settings": [
        { "id": "number", "type": "text", "label": "Stat Number", "default": "100%" },
        { "id": "label", "type": "text", "label": "Stat Label", "default": "Natural" }
      ]
    }
  ],
  "presets": [{ "name": "Our Story (Laushe)", "category": "Laushe Sections" }]
}
{% endschema %}

<section id="laushe-story" class="story-laushe-v2" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="story-grid-v2">
      <!-- LEFT CONTENT -->
      <div class="story-left">
        <span class="story-label-v2">{{ section.settings.subtitle }}</span>
        <h2 class="story-title-v2">{{ section.settings.title }}</h2>
        
        <div class="story-paragraphs">
          <p class="story-p-v2">{{ section.settings.description_1 }}</p>
          <p class="story-p-v2">{{ section.settings.description_2 }}</p>
        </div>

        <div class="story-stats-row-v2">
          {% for block in section.blocks %}
            <div class="story-stat-v2" {{ block.shopify_attributes }}>
              <span class="stat-large-v2 js-count-up" data-count="{{ block.settings.number | escape }}">{{ block.settings.number }}</span>
              <span class="stat-small-v2">{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- RIGHT IMAGE -->
      <div class="story-right">
        <div class="story-img-wrapper">
          {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | image_url: width: 1200 }}" class="story-img-v2" alt="{{ section.settings.title | escape }}" loading="lazy" width="1000" height="1200">
          {% else %}
            <img src="{{ 'where-tradition-meets.jpg' | asset_url }}" class="story-img-v2" alt="{{ section.settings.title | escape }}" loading="lazy" width="1000" height="1200">
          {% endif %}
          
          <div class="story-float-badge">
            {{ section.settings.badge_text }}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #laushe-story.story-laushe-v2 {
    padding: 120px 0;
    overflow: hidden;
  }

  #laushe-story .story-grid-v2 {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 80px;
    align-items: center;
  }

  #laushe-story .story-label-v2 {
    color: #D4AF37;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 25px;
    display: block;
  }

  #laushe-story .story-title-v2 {
    font-size: 52px;
    color: #007E40;
    margin-bottom: 40px;
    line-height: 1.1;
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  #laushe-story .story-paragraphs {
    margin-bottom: 50px;
  }

  #laushe-story .story-p-v2 {
    font-size: 16px;
    line-height: 1.7;
    color: #555;
    margin-bottom: 25px;
    max-width: 520px;
  }

  #laushe-story .story-stats-row-v2 {
    display: flex;
    gap: 60px;
    border-top: 1px solid rgba(0, 126, 64, 0.08);
    padding-top: 40px;
  }

  #laushe-story .story-stat-v2 {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #laushe-story .stat-large-v2 {
    font-size: 36px;
    font-weight: 800;
    color: #007E40;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  #laushe-story .stat-small-v2 {
    font-size: 14px;
    color: #888;
    font-weight: 600;
  }

  #laushe-story .story-right {
    width: 100%;
    min-width: 0;
  }

  #laushe-story .story-img-wrapper {
    position: relative;
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 40px;
  }

  #laushe-story .story-img-v2 {
    width: 100%;
    height: auto;
    display: block;
    margin: 0;
    border-radius: 40px;
    box-shadow: 0 40px 100px rgba(0,0,0,0.1);
    object-fit: cover;
    object-position: center;
  }

  #laushe-story .story-float-badge {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: auto;
    background: #D4AF37;
    color: white;
    padding: 12px 28px;
    border-radius: 12px;
    font-weight: 800;
    font-size: 15px;
    box-shadow: 0 15px 35px rgba(212, 175, 55, 0.4);
    z-index: 2;
  }

  @media (max-width: 1100px) {
    #laushe-story .story-grid-v2 {
      grid-template-columns: 1fr;
      gap: 48px;
      text-align: center;
    }
    #laushe-story .story-right {
      order: 1;
      width: 100%;
      max-width: 560px;
      margin: 0 auto;
      padding: 0;
      box-sizing: border-box;
    }
    #laushe-story .story-left { order: 2; }
    #laushe-story .story-p-v2 { margin: 0 auto 25px; }
    #laushe-story .story-stats-row-v2 { justify-content: center; }
    #laushe-story .story-img-wrapper {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      border-radius: 28px;
    }
    #laushe-story .story-img-v2 {
      width: 100%;
      border-radius: 28px;
    }
    #laushe-story .story-float-badge {
      left: 16px;
      bottom: 16px;
    }
    #laushe-story .story-title-v2 { font-size: 38px; }
  }

  @media (max-width: 768px) {
    #laushe-story.story-laushe-v2 {
      padding: 56px 0;
    }
    #laushe-story .story-right {
      width: 100%;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }
    #laushe-story .story-img-wrapper {
      width: 100%;
      margin: 0;
      border-radius: 24px;
    }
    #laushe-story .story-img-v2 {
      width: 100%;
      border-radius: 24px;
    }
    #laushe-story .story-float-badge {
      left: 14px;
      bottom: 14px;
      padding: 10px 18px;
      font-size: 13px;
    }
    #laushe-story .story-title-v2 { font-size: 32px; }
    #laushe-story .story-stats-row-v2 {
      gap: 28px;
      flex-wrap: wrap;
    }
  }
</style>
