{% style %}
  .laushe-collection-page {
    background: #ffffff;
    font-family: 'Inter', sans-serif;
    color: #333;
  }

  /* HERO — brand green, matches site */
  .laushe-collection-page .collection-hero {
    background: #007E40;
    color: #fff;
    padding: 72px 20px 64px;
    text-align: center;
  }
  .laushe-collection-page .collection-hero h1 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 800;
    margin: 0 0 12px;
    color: #ffffff;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .laushe-collection-page .collection-hero p {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    max-width: 560px;
    margin: 0 auto;
    color: rgba(255,255,255,0.9);
    line-height: 1.6;
  }

  /* FILTERS — homepage catalog style */
  .laushe-collection-page .filter-nav {
    background: #ffffff;
    padding: 28px 0 8px;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(0,126,64,0.08);
  }
  .laushe-collection-page .tab-list {
    display: flex;
    justify-content: center;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .laushe-collection-page .tab-link {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: #007E40 !important;
    -webkit-text-fill-color: #007E40;
    text-decoration: none;
    padding: 12px 28px;
    border-radius: 999px;
    border: 1.5px solid rgba(0,126,64,0.3);
    background: #ffffff !important;
    transition: 0.25s ease;
    cursor: pointer;
    text-transform: none;
    font-size: 14px;
    letter-spacing: 0;
    display: inline-block;
  }
  .laushe-collection-page .tab-link.active,
  .laushe-collection-page .tab-link:hover {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff;
    background: #007E40 !important;
    border-color: #007E40 !important;
  }

  /* GRID */
  .laushe-collection-page .grid-section {
    padding: 40px 0 80px;
    background: #ffffff;
    min-height: 400px;
  }
  .laushe-collection-page .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
    align-items: stretch;
    transition: opacity 0.3s ease;
  }

  /* CARDS — match homepage Wellness / Bestsellers */
  .laushe-collection-page .product-card {
    background: transparent;
    border-radius: 0;
    overflow: visible;
    box-shadow: none;
    transition: transform 0.35s ease;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 100%;
  }
  .laushe-collection-page .product-card:hover { transform: translateY(-4px); }

  .laushe-collection-page .product-img-wrap {
    position: relative;
    order: 0;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #FEF9E1;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 28px;
    margin-bottom: 18px;
  }
  .laushe-collection-page .product-img-wrap a {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    box-sizing: border-box;
  }
  .laushe-collection-page .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    background: #FEF9E1;
    display: block;
    transition: transform 0.4s ease;
  }
  .laushe-collection-page .product-card:hover .product-img { transform: scale(1.04); }

  .laushe-collection-page .best-seller-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #ffcc33;
    color: #000;
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    z-index: 2;
  }
  .laushe-collection-page .sale-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: #007E40;
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    z-index: 2;
  }

  .laushe-collection-page .product-info {
    order: 1;
    padding: 0 4px;
    text-align: left;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }
  .laushe-collection-page .product-title {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    margin: 0 0 8px;
    font-weight: 800;
    color: #1a1a1a;
    line-height: 1.25;
    height: 2.5em;
    min-height: 2.5em;
    max-height: 2.5em;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .laushe-collection-page .product-title a {
    color: inherit;
    text-decoration: none;
  }
  .laushe-collection-page .product-desc { display: none; }

  .laushe-collection-page .product-stars,
  .laushe-collection-page .card-stars {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
    min-height: 20px;
    flex-shrink: 0;
  }
  .laushe-collection-page .stars-gold {
    color: #C9A227;
    font-size: 13px;
    letter-spacing: 1px;
  }
  .laushe-collection-page .stars-rating,
  .laushe-collection-page .rating-num {
    font-weight: 700;
    font-size: 13px;
    color: #1a1a1a;
  }
  .laushe-collection-page .stars-count,
  .laushe-collection-page .review-count {
    color: #777;
    font-size: 13px;
  }

  .laushe-collection-page .product-price-wrapper {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 16px;
    min-height: 24px;
    flex-shrink: 0;
  }
  .laushe-collection-page .product-price {
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: 16px;
    color: #1a1a1a;
  }
  .laushe-collection-page .product-price-old {
    font-size: 14px;
    color: #999;
    text-decoration: line-through;
    font-weight: 500;
  }

  .laushe-collection-page .laushe-collection-atc {
    margin-top: auto;
    width: 100%;
  }
  .laushe-collection-page .btn-add,
  .laushe-collection-page .shop-now-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 14px 18px;
    border-radius: 999px;
    border: 1.5px solid #1a1a1a;
    background: transparent;
    color: #1a1a1a;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .laushe-collection-page .btn-add:hover,
  .laushe-collection-page .shop-now-btn:hover {
    background: #007E40;
    border-color: #007E40;
    color: #fff;
  }
  .laushe-collection-page .btn-add:disabled {
    background: #9aa39d;
    border-color: #9aa39d;
    color: #fff;
    cursor: not-allowed;
  }

  .laushe-collection-page .collection-group--hidden { display: none !important; }

  @media (max-width: 1100px) {
    .laushe-collection-page .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .laushe-collection-page .collection-hero { padding: 48px 16px 40px; }
    .laushe-collection-page .product-grid { grid-template-columns: 1fr; gap: 36px; }
    .laushe-collection-page .product-img-wrap { border-radius: 24px; }
    .laushe-collection-page .product-title { height: 2.5em; min-height: 2.5em; font-size: 17px; }
    .laushe-collection-page .tab-list {
      gap: 10px;
      overflow-x: auto;
      padding: 0 16px 8px;
      justify-content: flex-start;
      flex-wrap: nowrap;
      -webkit-overflow-scrolling: touch;
    }
    .laushe-collection-page .tab-link { white-space: nowrap; font-size: 13px; padding: 10px 20px; }
  }
{% endstyle %}

<div class="laushe-collection-page">
  <header class="collection-hero">
    <div class="container">
      <h1>{{ collection.title | default: 'Shop All' }}</h1>
      <p>{{ collection.description | default: 'Pure, Raw, and Bio-available supplements for every stage of your health journey.' | strip_html }}</p>
    </div>
  </header>

  <nav class="filter-nav">
    <div class="container">
      <ul class="tab-list" id="CollectionFilterTabs">
        <li><a href="javascript:void(0)" class="tab-link active" data-filter="all">All Products</a></li>
        <li><a href="javascript:void(0)" class="tab-link" data-filter="healthcare">Healthcare</a></li>
        <li><a href="javascript:void(0)" class="tab-link" data-filter="organic">Organic</a></li>
        <li><a href="javascript:void(0)" class="tab-link" data-filter="makeup">Makeup</a></li>
      </ul>
    </div>
  </nav>

  <main class="grid-section">
    <div class="container">
      <div class="product-grid" id="ProductGrid">
        {% assign priority_handles = "skinny-sips-weight-loss-kehwa,royce-hair-oil-sunnah-blessed,skin-tint,liquid-blush,chia-seeds300gm,pure-desi-ghee-500gm,golden-elixir,pure-honey450-gm,panjiri-450gm,weight-gainer-100-organic" | split: "," %}
        {% assign rendered_handles = "" %}

        {% comment %} PASS 1: homepage order {% endcomment %}
        {% for p_handle in priority_handles %}
          {% for product in collection.products %}
            {% if product.handle == p_handle %}
              {% assign rendered_handles = rendered_handles | append: product.handle | append: ',' %}
              {% render 'collection-product-card', product: product %}
            {% endif %}
          {% endfor %}
        {% endfor %}

        {% comment %} PASS 2: remaining products {% endcomment %}
        {% for product in collection.products %}
          {% assign handle_token = product.handle | append: ',' %}
          {% unless rendered_handles contains handle_token %}
            {% render 'collection-product-card', product: product %}
          {% endunless %}
        {% else %}
          <div style="grid-column: 1 / -1; text-align: center; padding: 48px 20px; color: #666;">
            <p>No products found in this collection.</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </main>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const tabs = document.querySelectorAll('.laushe-collection-page .tab-link');
    const groups = document.querySelectorAll('.laushe-collection-page .collection-group');
    const grid = document.getElementById('ProductGrid');

    function applyFilter(filter, bypassAnimation) {
      if (!bypassAnimation && grid) grid.style.opacity = '0.3';

      setTimeout(function() {
        groups.forEach(function(group) {
          var categories = group.getAttribute('data-category') || '';

          if (filter === 'all') {
            group.classList.remove('collection-group--hidden');
          } else if (categories.indexOf(filter) !== -1) {
            group.classList.remove('collection-group--hidden');
          } else {
            group.classList.add('collection-group--hidden');
          }
        });
        if (!bypassAnimation && grid) grid.style.opacity = '1';
      }, bypassAnimation ? 0 : 200);
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function(e) {
        e.preventDefault();
        var filter = tab.getAttribute('data-filter');
        tabs.forEach(function(t) { t.classList.remove('active'); });
        tab.classList.add('active');
        applyFilter(filter);

        var newUrl = window.location.pathname + '?filter=' + filter;
        window.history.pushState({ path: newUrl }, '', newUrl);
      });
    });

    var urlParams = new URLSearchParams(window.location.search);
    var externalFilter = urlParams.get('filter');
    if (externalFilter) {
      var targetTab = Array.prototype.find.call(tabs, function(t) {
        return t.getAttribute('data-filter') === externalFilter;
      });
      if (targetTab) {
        targetTab.click();
        var tabsEl = document.getElementById('CollectionFilterTabs');
        if (tabsEl) {
          window.scrollTo({ top: tabsEl.offsetTop - 100, behavior: 'smooth' });
        }
      }
    }

    document.querySelectorAll('.laushe-collection-atc').forEach(function(form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var btn = form.querySelector('.btn-add');
        var atcText = btn.querySelector('.atc-text');
        var atcLoading = btn.querySelector('.atc-loading');
        var variantId = form.querySelector('input[name="id"]').value;

        if (!variantId) {
          alert('Please select a valid product variant.');
          return;
        }

        atcText.style.display = 'none';
        atcLoading.style.display = 'inline';
        btn.style.opacity = '0.7';
        btn.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: parseInt(variantId), quantity: 1 })
        })
        .then(function(res) {
          if (!res.ok) throw new Error('Cart add failed');
          return res.json();
        })
        .then(function(data) {
          atcLoading.style.display = 'none';
          atcText.style.display = 'inline';
          atcText.innerText = 'Added!';
          btn.style.opacity = '1';

          if (window.LausheCart) {
            LausheCart.open();
          } else {
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
          }

          setTimeout(function() {
            atcText.innerText = 'SHOP NOW';
            btn.disabled = false;
          }, 2000);
        })
        .catch(function(err) {
          console.error('ATC error:', err);
          atcLoading.style.display = 'none';
          atcText.style.display = 'inline';
          atcText.innerText = 'Error!';
          btn.disabled = false;
          btn.style.opacity = '1';
          setTimeout(function() {
            atcText.innerText = 'SHOP NOW';
          }, 2500);
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Collection Grid AG1",
  "settings": [],
  "presets": [{ "name": "Collection Grid AG1" }]
}
{% endschema %}
