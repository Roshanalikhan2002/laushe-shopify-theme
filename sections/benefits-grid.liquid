{% schema %}
{
  "name": "Health Benefits Grid",
  "settings": [
    { "id": "heading", "type": "text", "label": "Heading", "default": "Transform Your Health" },
    { "id": "subheading", "type": "text", "label": "Subheading", "default": "Supported by nature, backed by tradition." },
    { "id": "center_image", "type": "image_picker", "label": "Center Circular Image" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "limit": 4,
      "settings": [
        { "id": "icon", "type": "image_picker", "label": "Icon (Optional)" },
        { "id": "icon_name", "type": "select", "label": "Or Choose Icon", "options": [
            {"value": "leaf", "label": "Leaf"},
            {"value": "flash", "label": "Energy"},
            {"value": "shield", "label": "Immunity"},
            {"value": "bulb", "label": "Brain"}
          ], "default": "leaf" 
        },
        { "id": "title", "type": "text", "label": "Title", "default": "Gut Health" },
        { "id": "desc", "type": "textarea", "label": "Description", "default": "Optimize digestion and nutrient absorption naturally." }
      ]
    }
  ],
  "presets": [{ "name": "Health Benefits Grid", "category": "Laushe Sections" }]
}
{% endschema %}

<section class="benefits-outer section-padding">
  <div class="container text-center">
    <div class="header-group" style="margin-bottom: 60px;">
      <h2 class="benefits-heading">{{ section.settings.heading }}</h2>
      <p class="benefits-subheading">{{ section.settings.subheading }}</p>
    </div>

    {% assign benefit_count = section.blocks.size %}
    <div class="benefits-circle-grid{% if benefit_count == 0 %} benefits-circle-grid--image-only{% endif %}">
      <!-- LEFT COLUMN -->
      {% if benefit_count > 0 %}
      <div class="benefit-col benefit-left">
        {% for block in section.blocks limit: 2 %}
          <div class="benefit-item-v2" {{ block.shopify_attributes }}>
            <div class="icon-box">
              {% if block.settings.icon %}
                <img src="{{ block.settings.icon | img_url: '60x' }}" alt="Icon">
              {% else %}
                {% render 'icon-laushe', name: block.settings.icon_name %}
              {% endif %}
            </div>
            <h3 class="benefit-title">{{ block.settings.title }}</h3>
            <p class="benefit-desc">{{ block.settings.desc }}</p>
          </div>
        {% endfor %}
      </div>
      {% endif %}

      <!-- CENTER COLUMN (IMAGE) -->
      <div class="benefit-center">
        <div class="center-circle-wrap">
          {% if product and product.handle == 'golden-elixir' %}
            <img src="{{ 'golden-elixir-product-page.jpg' | asset_url }}" class="circle-img" alt="Golden Elixir" loading="lazy">
          {% elsif product and product.handle contains 'skinny-sips' %}
            <img src="{{ 'kehwa-product-page.jpg' | asset_url }}" class="circle-img" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif product and product.handle contains 'hair-oil' %}
            <img src="{{ 'hair-oil-product-page.jpg' | asset_url }}" class="circle-img" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif product and product.handle contains 'honey' %}
            <img src="{{ 'honey-product-page.jpg' | asset_url }}" class="circle-img" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif product and product.handle contains 'chia' %}
            <img src="{{ 'chia-seeds-product-page.jpg' | asset_url }}" class="circle-img" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif product and product.handle contains 'panjiri' %}
            <img src="{{ 'panjiri-product-page.jpg' | asset_url }}" class="circle-img" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif product and product.handle contains 'ghee' %}
            <img src="{{ 'desi-ghee-product-page.jpg' | asset_url }}" class="circle-img" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif product and product.handle contains 'weight-gainer' %}
            <img src="{{ 'weight-gainer-product-page.jpg' | asset_url }}" class="circle-img" alt="{{ product.title | escape }}" loading="lazy">
          {% elsif section.settings.center_image != blank %}
            <img src="{{ section.settings.center_image | image_url: width: 800 }}" class="circle-img" alt="Health" loading="lazy">
          {% else %}
            <img src="{{ 'benefits-center-image.jpg' | asset_url }}" class="circle-img" alt="Health" loading="lazy">
          {% endif %}
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      {% if benefit_count > 2 %}
      <div class="benefit-col benefit-right">
        {% for block in section.blocks offset: 2 limit: 2 %}
          <div class="benefit-item-v2" {{ block.shopify_attributes }}>
            <div class="icon-box">
              {% if block.settings.icon %}
                <img src="{{ block.settings.icon | img_url: '60x' }}" alt="Icon">
              {% else %}
                {% render 'icon-laushe', name: block.settings.icon_name %}
              {% endif %}
            </div>
            <h3 class="benefit-title">{{ block.settings.title }}</h3>
            <p class="benefit-desc">{{ block.settings.desc }}</p>
          </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .benefits-outer {
    background: #FEF9E1;
    color: #333333;
  }

  .benefits-outer.section-padding {
    padding-bottom: 40px;
  }

  .benefits-heading {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(32px, 4vw, 48px);
    margin-bottom: 15px;
    color: #dcb360 !important; /* yellow/gold */
    font-weight: 800;
  }

  .benefits-subheading {
    color: #555555 !important;
    font-size: 16px;
  }

  .benefits-circle-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    align-items: center;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .benefits-circle-grid--image-only {
    grid-template-columns: minmax(0, 520px);
    justify-content: center;
    gap: 0;
  }
  
  .benefit-col {
    display: flex;
    flex-direction: column;
    gap: 100px;
  }
  
  .benefit-left { text-align: right; }
  .benefit-right { text-align: left; }
  
  .benefit-item-v2 {
    transition: transform 0.3s ease;
  }
  
  .benefit-left .icon-box { justify-content: flex-end; }
  .benefit-right .icon-box { justify-content: flex-start; }
  
  .icon-box {
    display: flex;
    margin-bottom: 15px;
  }
  
  .icon-box svg, .icon-box img {
    width: 44px;
    height: 44px;
    color: #007E40; /* Quality green */
  }
  
  .benefit-title {
    font-family: 'Poppins', sans-serif;
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 8px;
    color: #007E40 !important; /* Quality green */
  }
  
  .benefit-desc {
    font-size: 15px;
    color: #444444 !important;
    line-height: 1.5;
    max-width: 280px;
  }
  
  .benefit-left .benefit-desc { margin-left: auto; }
  
  .center-circle-wrap {
    position: relative;
    padding: 0;
  }
  
  .circle-img {
    width: 100%;
    height: auto;
    border-radius: 50%;
    aspect-ratio: 1/1;
    object-fit: contain;
    object-position: center;
    background: #FEF9E1;
    box-shadow: 0 20px 60px rgba(0,0,0,0.12);
    border: 1px solid #EEE;
    display: block;
  }
  
  @media (max-width: 1024px) {
    .benefits-outer.section-padding {
      padding-bottom: 16px;
    }

    .benefits-circle-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .benefits-circle-grid--image-only {
      gap: 0;
    }
    
    .benefit-center { order: 1; max-width: 400px; width: 100%; margin: 0 auto; }
    .benefit-left { order: 2; text-align: center; gap: 40px; }
    .benefit-right { order: 3; text-align: center; gap: 40px; }
    
    .benefit-left .icon-box, .benefit-right .icon-box { justify-content: center; }
    .benefit-left .benefit-desc { margin: 0 auto; }
    .benefit-desc { max-width: 100%; }
    
    .benefit-col { gap: 40px; }
  }
</style>
