<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#007E40">
    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="icon" type="image/jpeg" href="{{ 'laushe-logo.jpg' | asset_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800&family=Poppins:wght@400;700;800&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- Laushe Base CSS -->
    {{ 'base-redesign.css' | asset_url | stylesheet_tag }}

    <!-- Ionicons -->
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
  </head>

  <body class="gradient{% if settings.force_all_sold_out %} laushe-force-sold-out{% endif %}">

    <!-- ANNOUNCEMENT BAR -->
    <div class="announcement-bar">
      {% if settings.force_all_sold_out %}
        {{ settings.sold_out_message | default: 'All products are currently sold out. Orders cannot be placed right now.' }}
      {% else %}
        ✨ Limited Time Sale ✨ Shop Now
      {% endif %}
    </div>

    <!-- STICKY HEADER -->
    {% section 'header' %}

    <!-- MAIN CONTENT -->
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- FOOTER -->
    <footer id="footer" style="background-color: #F9F9F9; padding: 80px 0 40px; border-top: 1px solid #EEE;">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h4 style="color: #007E40; font-family: 'Poppins', sans-serif; font-size: 20px; margin-bottom: 20px;">LAUSHE</h4>
            <p style="font-size: 14px; color: #777; line-height: 1.8;">Pure. Natural. Effective. Wellness rooted in tradition, crafted for today.</p>
          </div>
          <div>
            <h4 style="margin-bottom: 20px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em;">Shop</h4>
            <ul style="list-style: none; padding: 0;">
              <li style="margin-bottom: 10px;"><a href="/#laushe-shop?filter=healthcare" style="text-decoration: none; color: #555; font-size: 14px;">Healthcare</a></li>
              <li style="margin-bottom: 10px;"><a href="/#laushe-shop?filter=organic" style="text-decoration: none; color: #555; font-size: 14px;">Organic Products</a></li>
              <li style="margin-bottom: 10px;"><a href="/#laushe-shop?filter=all" style="text-decoration: none; color: #555; font-size: 14px;">All Products</a></li>
            </ul>
          </div>
          <div>
            <h4 style="margin-bottom: 20px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em;">Company</h4>
            <ul style="list-style: none; padding: 0;">
              <li style="margin-bottom: 10px;"><a href="/#laushe-story" style="text-decoration: none; color: #555; font-size: 14px;">Our Story</a></li>
              <li style="margin-bottom: 10px;"><a href="/pages/contact" style="text-decoration: none; color: #555; font-size: 14px;">Contact Us</a></li>
            </ul>
          </div>
          <div>
            <h4 style="margin-bottom: 20px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em;">Contact</h4>
            <p style="font-size: 14px; color: #777; margin-bottom: 10px;">laushebyzahra@gmail.com</p>
            <p style="font-size: 14px; color: #777;">Pakistan 🇵🇰</p>
            <div style="display: flex; gap: 15px; margin-top: 20px;">
              <a href="https://www.instagram.com/laushebyzahra?igsh=MWx5ZXMxN2czNDQ2cA%3D%3D" target="_blank" style="color: #555; font-size: 22px;"><ion-icon name="logo-instagram"></ion-icon></a>
              <a href="{{ shop.facebook_url }}" style="color: #555; font-size: 22px;"><ion-icon name="logo-facebook"></ion-icon></a>
            </div>
          </div>
        </div>
        <div style="border-top: 1px solid #EEE; margin-top: 60px; padding-top: 30px; text-align: center; font-size: 13px; color: #999;">
          © {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        </div>
      </div>
    </footer>



    {% section 'cart-drawer' %}

    {% if settings.force_all_sold_out %}
      <style>
        body.laushe-force-sold-out .atc-btn-v3,
        body.laushe-force-sold-out .m-atc,
        body.laushe-force-sold-out .btn-add,
        body.laushe-force-sold-out .sticky-atc-btn,
        body.laushe-force-sold-out .checkout-btn-offer,
        body.laushe-force-sold-out .checkout-btn,
        body.laushe-force-sold-out button[name="checkout"],
        body.laushe-force-sold-out button[type="submit"].atc-btn-v3 {
          pointer-events: none !important;
          opacity: 0.65 !important;
          cursor: not-allowed !important;
          background: #9aa39d !important;
          border-color: #9aa39d !important;
          color: #fff !important;
        }
      </style>
      <script>
        (function () {
          var SOLD_OUT_LABEL = {{ settings.sold_out_button_label | default: 'Sold Out' | json }};
          var SOLD_OUT_MSG = {{ settings.sold_out_message | default: 'All products are currently sold out. Orders cannot be placed right now.' | json }};
          window.LAUSHE_FORCE_SOLD_OUT = true;

          function isCartAddUrl(url) {
            try {
              var u = typeof url === 'string' ? url : (url && url.url) || '';
              return /\/cart\/add(\.js)?(\?|$)/i.test(String(u));
            } catch (e) {
              return false;
            }
          }

          function isCheckoutUrl(url) {
            try {
              var u = typeof url === 'string' ? url : (url && url.url) || '';
              return /\/checkout(\?|$)/i.test(String(u)) || /\/cart(\?|$)/i.test(String(u)) && /checkout/i.test(String(u));
            } catch (e) {
              return false;
            }
          }

          var nativeFetch = window.fetch;
          if (typeof nativeFetch === 'function') {
            window.fetch = function (input, init) {
              var url = typeof input === 'string' ? input : (input && input.url);
              if (isCartAddUrl(url) || isCheckoutUrl(url)) {
                return Promise.reject(new Error(SOLD_OUT_MSG));
              }
              return nativeFetch.apply(this, arguments);
            };
          }

          document.addEventListener('submit', function (e) {
            var form = e.target;
            if (!form || !form.getAttribute) return;
            var action = (form.getAttribute('action') || '').toLowerCase();
            if (action.indexOf('/cart/add') !== -1 || (form.id === 'CartDrawerFooter') || form.querySelector('[name="checkout"]')) {
              e.preventDefault();
              e.stopPropagation();
              alert(SOLD_OUT_MSG);
            }
          }, true);

          document.addEventListener('click', function (e) {
            var el = e.target && e.target.closest
              ? e.target.closest('.atc-btn-v3, .m-atc, .btn-add, .sticky-atc-btn, .checkout-btn-offer, .checkout-btn, button[name="checkout"], .shop-now-btn, .bs-shop-now')
              : null;
            if (!el) return;
            if (el.classList.contains('shop-now-btn') || el.classList.contains('bs-shop-now')) {
              return; /* allow product page navigation */
            }
            e.preventDefault();
            e.stopPropagation();
            alert(SOLD_OUT_MSG);
          }, true);

          function markSoldOutButtons() {
            var selectors = [
              '.atc-btn-v3 .atc-text',
              '.atc-btn-v3',
              '.m-atc',
              '.btn-add .atc-text',
              '.btn-add',
              '.sticky-atc-btn',
              '.checkout-btn-offer',
              '.checkout-btn',
              'button[name="checkout"]'
            ];
            selectors.forEach(function (sel) {
              document.querySelectorAll(sel).forEach(function (btn) {
                if (btn.matches('button, a, .m-atc, .sticky-atc-btn, .checkout-btn-offer, .checkout-btn')) {
                  if (btn.tagName === 'BUTTON' || btn.tagName === 'A') {
                    btn.setAttribute('disabled', 'disabled');
                    btn.setAttribute('aria-disabled', 'true');
                  }
                  if (btn.classList.contains('atc-text') || btn.childElementCount === 0 || btn.classList.contains('m-atc') || btn.classList.contains('sticky-atc-btn') || btn.classList.contains('checkout-btn') || btn.classList.contains('checkout-btn-offer') || btn.name === 'checkout') {
                    if (!btn.dataset.lausheSoldOutLabeled) {
                      if (btn.classList.contains('atc-text') || btn.childElementCount === 0 || btn.classList.contains('m-atc') || btn.classList.contains('sticky-atc-btn') || btn.classList.contains('checkout-btn-offer') || btn.classList.contains('checkout-btn') || btn.name === 'checkout') {
                        btn.textContent = btn.name === 'checkout' || btn.classList.contains('checkout-btn') ? SOLD_OUT_LABEL : SOLD_OUT_LABEL;
                        btn.dataset.lausheSoldOutLabeled = '1';
                      }
                    }
                  }
                }
              });
            });
            document.querySelectorAll('.atc-btn-v3 .atc-text, .btn-add .atc-text').forEach(function (el) {
              el.textContent = SOLD_OUT_LABEL;
            });
            document.querySelectorAll('.m-atc, .sticky-atc-btn, .checkout-btn-offer').forEach(function (el) {
              el.textContent = SOLD_OUT_LABEL;
            });
            document.querySelectorAll('.checkout-btn, button[name="checkout"]').forEach(function (el) {
              el.textContent = SOLD_OUT_LABEL;
              el.setAttribute('disabled', 'disabled');
            });
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', markSoldOutButtons);
          } else {
            markSoldOutButtons();
          }
          document.addEventListener('shopify:section:load', markSoldOutButtons);
          setTimeout(markSoldOutButtons, 800);
        })();
      </script>
    {% endif %}
    <script src="{{ 'laushe-countup-v2.js' | asset_url }}" defer></script>
    <script>
      (function () {
        try {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        } catch (e) {}

        function isReload() {
          try {
            var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
            if (nav) return nav.type === 'reload';
            if (performance.navigation) return performance.navigation.type === 1;
          } catch (e) {}
          return false;
        }

        function forceTopOnReload() {
          if (!isReload()) return;
          if (window.location.hash) {
            try {
              history.replaceState(null, '', window.location.pathname + window.location.search);
            } catch (e) {}
          }
          window.scrollTo(0, 0);
        }

        forceTopOnReload();
        document.addEventListener('DOMContentLoaded', forceTopOnReload);
        window.addEventListener('load', function () {
          forceTopOnReload();
          // Enable smooth scrolling only after initial paint (avoids hash jump feel)
          setTimeout(function () {
            document.documentElement.classList.add('laushe-smooth-scroll');
          }, 300);
        });
        window.addEventListener('pageshow', function (e) {
          if (e.persisted) forceTopOnReload();
        });
      })();
    </script>
  </body>
</html>
