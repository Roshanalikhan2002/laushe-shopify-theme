<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Inter, Poppins, system-ui, sans-serif;
      background: #fafafa;
      color: #222;
    }
    .password-page {
      width: min(420px, 92vw);
      text-align: center;
      padding: 40px 24px;
    }
    h1 {
      color: #004225;
      font-size: 28px;
      margin: 0 0 12px;
      line-height: 1.3;
    }
    .subtext {
      color: #666;
      font-size: 15px;
      margin: 0 0 28px;
    }
    .password-form {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .password-form input[type="password"] {
      width: 100%;
      box-sizing: border-box;
      padding: 14px 16px;
      border: 1px solid #ddd;
      border-radius: 10px;
      font-size: 16px;
    }
    .password-form button {
      padding: 14px 16px;
      border: 0;
      border-radius: 10px;
      background: #004225;
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }
    .password-form button:hover { background: #00331c; }
    .errors {
      color: #b00020;
      font-size: 14px;
      margin-bottom: 8px;
    }
  </style>
</head>
<body>
  <div class="password-page">
    <h1>Laushe Redesign is Launching Soon</h1>
    <p class="subtext">This store is currently in development mode. Enter the password to continue.</p>

    {% form 'storefront_password', class: 'password-form' %}
      {% if form.errors %}
        <div class="errors">{{ form.errors | default_errors }}</div>
      {% endif %}
      <input
        type="password"
        name="password"
        id="Password"
        placeholder="Enter store password"
        autocomplete="current-password"
        autofocus
      >
      <button type="submit">Enter</button>
    {% endform %}
  </div>
</body>
</html>